---
import '../styles/global.css';
import 'lenis/dist/lenis.css'; /* Lenis grund-CSS (mjuk scroll, scripts/smooth.ts) */
import Nav from '../components/Nav.astro';
import SeosGuard from '../components/SeosGuard.astro';
import { canonicalUrl, pageGraph, SITE_URL, type Crumb, type PageType } from '../lib/site';

interface Props {
  title?: string;
  description?: string;
  /** og:type — "article" på artiklar, annars "website". */
  ogType?: "website" | "article";
  noindex?: boolean;
  /** Delningsbild (absolut sökväg under public/). Standard: /og-default.png, 1200×630. */
  image?: string;
  /** Strukturerad data (lib/site.ts pageGraph): sidans typ, brödsmulor (utan Hem),
      huvudentitetens @id och extra noder (Article, FAQPage, Service …). */
  pageType?: PageType;
  breadcrumb?: Crumb[];
  mainEntity?: string;
  schema?: object[];
}

const {
  title = 'AI Partner – AI-byrå för AI-agenter och automation',
  description = 'AI Partner är AI-byrån som bygger AI-agenter och automation åt svenska företag – från kostnadsfri kartläggning till en lösning i drift.',
  ogType = "website",
  noindex = false,
  image = '/og-default.png',
  pageType = 'WebPage',
  breadcrumb,
  mainEntity,
  schema = [],
} = Astro.props;
const imageUrl = new URL(image, SITE_URL).href;

// Canonical + og:url: www-adressen utan avslutande snedstreck (lib/site.ts).
const canonical = canonicalUrl(Astro.url.pathname);
// En entitetsgraf per sida: Organization + WebSite + Person + WebPage + sidans noder.
const graph = pageGraph({ url: canonical, title, description, image: imageUrl, pageType, breadcrumb, mainEntity, nodes: schema });
---

<!doctype html>
<html lang="sv">
  <head>
    <meta charset="UTF-8" />
    <SeosGuard />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* SEOS cookierutan. data-site-key är publik och måste finnas: utan den avvisas varje
        samtycke. Grinden i scripts/consent.ts väntar på rutans window.SEOS och laddar GA4
        först när besökaren sagt ja till statistik. */}
    <script is:inline src="https://seos-cookie-banner.vercel.app/v1/banner.js" data-site-key="pk_live_38ddf2e1cc84b94b27f915c4c35aacb4" async></script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#0a0a0a" />
    {/* Mona Sans självhostad (global.css @font-face, filerna i public/fonts/). Preload på
        latin normal – den fil all synlig text använder – så den hämtas parallellt med CSS:en
        i stället för efter den. crossorigin krävs för fonter även på samma origin. */}
    <link rel="preload" href="/fonts/mona-sans-latin-normal.woff2" as="font" type="font/woff2" crossorigin />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content="sv_SE" />
    <meta property="og:site_name" content="AI Partner" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AI Partner – vi bygger AI-agenter och automation som tar rutinarbetet." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    {/* Strukturerad data på alla sidor (lib/site.ts). */}
    <script type="application/ld+json" set:html={JSON.stringify(graph)} is:inline />
    {/* Sidspecifikt i <head>. */}
    <slot name="head" />
  </head>
  <body>
     <Nav/> 
     <slot />
     {/* Rubrik-drapen: delar [data-split]-rubriker i ord (se global.css). */}
     <script>
       import '../scripts/split';
       import '../scripts/smooth';
       /* GA4 bakom samtycke (scripts/consent.ts): laddar inget förrän cookierutan sagt ja. */
       import '../scripts/consent';
       /* Händelser till GA4 (scripts/track.ts): lead, CTA-klick, mejl/telefon. Skickar bara efter samtycke. */
       import '../scripts/track';
     </script>
  </body>
</html>

