---
// Positionering.astro – sektion direkt under Hero: sidans "vad gör AI Partner?"-
// statement. Stort, fett, vänsterställt påstående (SEOS-kadens: "Vi bygger… Vi
// hjälper…") med en diskret azur-accent (lysande punkt på sista punkten), dämpad
// stödtext och sidans två CTA:er. Portad från Claude
// Design ("Positionering") till Astro-konventioner: globala tokens, delade
// knappar, reveal-on-scroll, ingen dev-panel.
//
// CTA:erna är FLYTTADE HIT FRÅN HERON (heron är nu ren, utan knappar). Löser
// CTA-dubbleringen och ger sektionen syfte.
//
// KNAPPARNA (2026-07-17, efter fundamental.bg-referensen Björn valde): båda är
// MÖRKA med lysande azur-kant. "Boka kartläggning" = `.btn-glow` (statiskt sken,
// kanten ljus till vänster och uttonad åt höger). "Mer om oss" = `.btn-comet`
// (azur blob som orbiterar kanten, ~4 s/varv). Bägge definierade i global.css.
// Ersatte `.btn-azur` (nu oanvänd, kvar i global.css för enkel revert) och vit
// `.btn-primary`.
//
// Accentvarianterna ligger i EGNA klasser, aldrig på .btn-primary: den är
// centraliserad och hade färgat om StartFlow, Team och Contact också.
import Arrow from './Arrow.astro';
---

<section id="positionering" class="pos" aria-labelledby="pos-stmt">
  {/* Partikelnätet, FLYTTAT HIT FRÅN HERON 2026-07-17 (heron har bakgrundsbild nu).
      Lutad vågyta i perspektiv. Ligger bakom innehållet med en slöja emellan som
      skyddar läsbarheten — nätet ritar vita punkter upp till 0.75 alpha.
      OBS: det ritar COLS×ROWS fyrkanter per bildruta på HUVUDTRÅDEN (~12 400 vid
      full bredd). Scriptet pausar när sektionen är ur bild. */}
  <canvas class="mesh-canvas" aria-hidden="true"></canvas>
  <div class="mesh-veil" aria-hidden="true"></div>

  <div class="container">
    <h2 class="stmt" id="pos-stmt">
      Vi bygger AI-agenter och automation som tar rutinarbetet<span class="az">.</span>
    </h2>

    <p class="pos__body">
      Teamen slipper det repetitiva och lägger tiden där den gör skillnad — så ni växer utan
      att anställa fler. Utgångspunkten är era egna processer och data; vi automatiserar bara
      det som lönar sig.
    </p>

    <div class="pos__cta">
      <a class="btn btn-glow" href="#boka">Boka kartläggning <Arrow class="arrow" /></a>
      <a class="btn btn-comet" href="/om-oss">Mer om oss <Arrow class="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .pos {
    position: relative;
    padding: var(--section-py) 0;
    overflow: hidden;
    isolation: isolate;
  }

  /* ══════════ PARTIKELNÄTET (flyttat hit från Hero 2026-07-17) ══════════ */
  .mesh-canvas {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    display: block;
  }
  /* Slöjan skyddar läsbarheten mot nätets vita punkter och tonar ut det mot
     sektionens kanter, så det läser som atmosfär och inte som en tapet.
     Motsvarar den gamla .hero-veil, som låg på 0.85 i mitten av samma skäl. */
  .mesh-veil {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(ellipse 70% 60% at 30% 50%, rgba(10, 10, 10, 0.88) 0%, rgba(10, 10, 10, 0.2) 70%),
      linear-gradient(to bottom, var(--bg) 0%, rgba(10, 10, 10, 0) 22%, rgba(10, 10, 10, 0) 78%, var(--bg) 100%);
  }
  .pos .container { position: relative; z-index: 2; }

  @media (prefers-reduced-motion: reduce) {
    .mesh-canvas { opacity: 0.5; }
  }

  .stmt {
    max-width: 20ch;
    font-weight: 800;
    font-stretch: 78%;
    font-size: clamp(36px, 5.6vw, 72px);
    line-height: 1.02;
    letter-spacing: -0.03em;
    color: var(--fg-1);
    text-wrap: balance;
  }
  /* lysande vit punkt på den avslutande punkten */
  .stmt .az {
    color: #fff;
    text-shadow:
      0 0 18px rgba(255, 255, 255, 0.9),
      0 0 42px rgba(255, 255, 255, 0.5);
  }

  /* stödtext — dämpad, smalare mätt */
  .pos__body {
    margin-top: clamp(26px, 3.4vw, 40px);
    max-width: var(--maxw-text);
    font-size: var(--fs-lead);
    line-height: 1.62;
    color: var(--fg-3);
    text-wrap: pretty;
  }

  /* CTA-rad (flyttad från heron): azur primär + vit sekundär */
  .pos__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: clamp(18px, 2.4vw, 30px);
    margin-top: clamp(30px, 4vw, 46px);
  }

  /* ---- Reveal-on-scroll: synligt som bas, rörelse förstärker (repo-konvention).
          Staggrad in när sektionen syns. ---- */
  .stmt,
  .pos__body,
  .pos__cta {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .pos.is-inview .stmt {
      animation: posRise var(--dur-mid) var(--ease) backwards;
      animation-delay: 0.08s;
    }
    .pos.is-inview .pos__body {
      animation: posRise var(--dur-mid) var(--ease) backwards;
      animation-delay: 0.22s;
    }
    .pos.is-inview .pos__cta {
      animation: posRise var(--dur-mid) var(--ease) backwards;
      animation-delay: 0.32s;
    }
  }
  @keyframes posRise {
    from {
      opacity: 0;
      transform: translateY(14px);
    }
  }

  @media (max-width: 620px) {
    .stmt {
      max-width: none;
    }
    .pos__cta {
      flex-direction: column;
      align-items: flex-start;
      gap: 18px;
    }
  }
</style>

<script>
  // Reveal-on-scroll: lägg .is-inview på sektionen när den syns (staggern bor i CSS).
  (function () {
    const section = document.querySelector('.pos');
    if (!section) return;
    if (!('IntersectionObserver' in window)) {
      section.classList.add('is-inview');
      return;
    }
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((e) => {
          if (e.isIntersecting) {
            e.target.classList.add('is-inview');
            io.unobserve(e.target);
          }
        });
      },
      { threshold: 0.2 },
    );
    io.observe(section);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  })();
</script>

<script>
  // Animerad canvas: lutad vågyta i perspektiv (Anduril-inspirerad, inte en kopia).
  // Blandar slumpmässigt mellan ett stort diagonalt svep från höger och turbulenta
  // smårvágor som krockar. Autonomt utan musinteraktion.
  (function () {
    const canvas = document.querySelector<HTMLCanvasElement>('.mesh-canvas');
    if (!canvas) return;
    const ctx = canvas.getContext('2d');
    if (!ctx) return;
    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    let raf = 0, W = 0, H = 0, dpr = 1, t = 2.0, visible = true;
    let COLS = 0, ROWS = 0;

    // Pillfunktioner (ej hoistade) — TypeScript bevarar narrowingen av canvas/ctx
    const resize = (): void => {
      dpr = Math.min(window.devicePixelRatio || 1, 1.75);
      W = canvas.clientWidth;
      H = canvas.clientHeight;
      canvas.width  = Math.round(W * dpr);
      canvas.height = Math.round(H * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      // Fler kolumner/rader = tätare nät = tydligare vågrörelse
      COLS = Math.max(80, Math.min(150, Math.round(W / 10)));
      ROWS = Math.max(80, Math.min(135, Math.round(H / 7)));
    };

    const ro = new ResizeObserver(resize);
    ro.observe(canvas);
    resize();

    // Vandrar mjukt mellan enhetligt svep (1) och turbulenta krockar (0).
    // Tre sinusvågor med inkommensurabel frekvens = aldrig exakt samma period.
    const regime = (time: number): number => {
      const v = Math.sin(time * 0.055)
              + Math.sin(time * 0.087 + 1.7)
              + Math.sin(time * 0.033 + 4.2);
      return (v / 3 + 1) / 2;
    };

    const frame = (animate: boolean): void => {
      ctx.clearRect(0, 0, W, H);

      const reg  = regime(t);
      const wBig = 0.34 + 0.66 * reg;
      const wTur = 0.34 + 0.66 * (1 - reg);

      const topEdge = -H * 0.06;  // lite ovanför kanten → täcker hela sektionen
      const botEdge =  H * 1.06;
      const cx = W / 2;

      ctx.fillStyle = '#ffffff';

      for (let j = 0; j < ROWS; j++) {
        const n     = j / (ROWS - 1);             // 0 = horisont (topp), 1 = nära
        const persp = Math.pow(n, 1.38);          // rader tätnar mot horisonten
        const rowY  = topEdge + persp * (botEdge - topEdge);
        const spread = 1.04 + 0.06 * n;
        const size   = 1.0 + n * 1.4;
        const amp    = 26 + n * 74;               // vågkammar reser sig mer nära
        const zf     = 1 - n;                    // djupfaktor: 0 nära, 1 långt borta

        for (let i = 0; i < COLS; i++) {
          const u  = i / (COLS - 1) - 0.5;
          const wx = u * 2;

          // STOR VÅG — parallella kammar in diagonalt från höger hörn
          const big = Math.sin((-wx * 1.6 + zf * 2.6) * 3.2 - t * 1.15);

          // TURBULENS — interferens från flera riktningar = krockande smárvágor
          let tur = Math.sin(wx * 5.0 + t * 1.5)
                  + Math.sin(zf * 5.8 - t * 1.2)
                  + Math.sin((wx + zf) * 4.1 + t * 1.85)
                  + Math.sin((wx - zf) * 5.4 - t * 1.45);
          tur *= 0.25;

          const h    = big * wBig + tur * wTur;
          const lift = (h + 1) / 2;

          const sx = cx + u * W * spread;
          const sy = rowY - h * amp;             // kammen lyfts uppåt

          // Smoothstep-ljussättning: mjuka kammar, ingen flicker
          const e     = lift * lift * (3 - 2 * lift);
          const alpha = (0.09 + e * 0.66) * (0.55 + 0.45 * n);
          ctx.globalAlpha = alpha;
          ctx.fillRect(sx, sy, size, size);
        }
      }

      ctx.globalAlpha = 1;
      if (animate && visible) {
        t += 0.011;
        raf = requestAnimationFrame(() => frame(true));
      }
    };

    // Pausa rAF-loopen när heron är helt utanför skärmen — sparar CPU/GPU för
    // resten av sidan. Återupptas när den scrollas in igen.
    let io: IntersectionObserver | null = null;
    if (reduce) {
      frame(false);
    } else {
      frame(true);
      io = new IntersectionObserver((entries) => {
        const nowVisible = entries[0].isIntersecting;
        if (nowVisible && !visible) {
          visible = true;
          frame(true);
        } else if (!nowVisible && visible) {
          visible = false;
          cancelAnimationFrame(raf);
        }
      }, { threshold: 0 });
      io.observe(canvas);
    }

    // Städa upp vid View Transitions-navigering
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(raf);
      ro.disconnect();
      io?.disconnect();
    }, { once: true });
  })();
</script>
