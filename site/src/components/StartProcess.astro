---
// StartProcess.astro – "Var börjar ni med AI?" i Consolidator-stil (2026-09-25).
// Referens: consolidator.aero → "Our process".
//
// LÅST BILDRUTA: hela vyn (rubrik + steg + bild) låses som EN enhet (.proc__pin,
// sticky, 100svh) medan sektionen scrollas. Stegen flyttas inne i den med
// scrollen och tonas/suddas ut ju längre från mitten de är. Allt släpper
// samtidigt efter sista steget. (Första versionen hade två separata sticky-kolumner
// som släppte vid olika tidpunkter, med en CTA som hängde efter → "konstigt bryt".)
// CTA:n ligger därför i sista steget.
//
// Bilden = Wannathis "Glass abstract animated shapes" → Cube (dark theme), samma
// paket som heron: de första 4 s av 16 (långsam rotation), kvadrat runt kuben
// (crop=2160:2160:840:0). RITAS PÅ CANVAS ur en bildsekvens (public/proc-cube/
// f001–f120.webp, 900 px, q75, 2,7 MB), inte som spolad video: videosökningen gav
// bara ~25 uppdateringar/s med glapp upp till 200 ms (uppmätt 2026-09-27, Björn:
// "laggigt"). Bilderna ritas direkt och tonas över mellan grannbilder → flytande
// rörelse i skärmens takt. Svart bakgrund → mix-blend-mode: lighten mot scenens
// egen bakgrund + ett indigo-sken bakom kuben som skiftar nyans med scrollen.
//
// 2026-10-08 (efter avstämning, Björns val "B"): i låst läge ligger kuben BAKOM
// innehållet, nedtonad (--cube-dim), och rubrik + steg är centrerade. Förut stod
// kuben stor och ljus i en egen högerkolumn och vägde tyngre än de tre stegen.
// Scrollmekaniken är oförändrad (stegen rullar förbi ett i taget).
//
// Låst läge slås på av scriptet (.is-pinned) bara på breda skärmar utan reduced
// motion. Annars (och utan JS): vanligt flöde, stegen under varandra, kuben som
// stillbild (sekvensen laddas bara i låst läge).
//
// Tidigare varianter finns kvar: StartFlowRail.astro, StartFlow.astro (vågen),
// StartFlow.cascade.astro.bak. Växla i index.astro.
import Arrow from './Arrow.astro';

const BOOK = '/kontakt';
const STEPS = [
  { h: 'Kartläggning på plats', t: 'Vi går igenom era processer på plats. Vad tar tid i dag, och vad återkommer varje vecka?' },
  { h: 'Prioritering', t: 'Var ger AI och automation störst effekt, och var gör den det inte? Vi är ärliga med båda.' },
  { h: 'Åtgärdsplan', t: 'Konkret och prioriterad. Inget köptvång, ni bestämmer själva om ni går vidare.' },
];
---

<section id="sa-borjar-ni" class="proc" aria-labelledby="proc-title" style={`--n: ${STEPS.length}`}>
  <div class="proc__pin">
    <div class="proc__grid">
      <div class="proc__text">
        <div class="proc__head">
          <h2 id="proc-title" class="proc__h2">Var börjar ni med AI?</h2>
          <p class="proc__lead">Med en kostnadsfri kartläggning.</p>
        </div>

        <div class="proc__viewport">
          <ol class="proc__steps">
            {STEPS.map((s, i) => (
              <li class="pstep" data-step={i}>
                <div class="pstep__inner">
                  <span class="pstep__n">
                    {String(i + 1).padStart(2, '0')}
                  </span>
                  <h3 class="pstep__h">{s.h}</h3>
                  <p class="pstep__t">{s.t}</p>
                  {i === STEPS.length - 1 && (
                    <div class="pstep__cta">
                      <a class="btn btn-primary" href={BOOK}>Boka en tid <Arrow class="arrow" /></a>
                      <p class="pstep__note">Vill ni förstå AI först? Vi kan också komma ut och föreläsa för ert team.</p>
                    </div>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </div>
      </div>

      <div class="proc__visual" aria-hidden="true">
        <div class="proc__stage">
          <span class="proc__glow"></span>
          {/* Stillbild (första bildrutan): visas på mobil, vid reduced motion, utan JS
              och tills bildsekvensen laddats. Canvasen ritar kuben i låst läge. */}
          <img class="proc__video proc__poster" src="/proc-cube-poster.webp" alt="" width="720" height="720" loading="lazy" decoding="async" />
          <canvas class="proc__video proc__canvas"></canvas>
        </div>
      </div>
    </div>

    {/* Diskret scroll-indikator vid vänsterkanten (Consolidator), bara i låst läge. */}
    <div class="proc__rail" aria-hidden="true">
      {STEPS.map(() => <span class="proc__seg"></span>)}
    </div>
  </div>
</section>

<style>
  .proc {
    --lock: 94px; /* under den flytande nav-pillen (samma som StackFlow) */
    --p: 0; /* scroll-progress 0–1, sätts av scriptet */
    position: relative;
    padding: var(--section-py) 0;
  }
  .proc__grid {
    max-width: var(--maxw-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    gap: clamp(24px, 4vw, 64px);
  }

  /* ---- typografi ---- */
  .proc__h2 {
    text-wrap: balance; /* jämna rader i den smala spalten (annars ensamt "AI?") */
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-1);
  }
  .proc__lead {
    margin-top: var(--space-4);
    color: var(--fg-3);
    font-size: var(--fs-lead);
    line-height: 1.6;
  }
  .proc__steps {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  /* Stegnumret: "(03)"-totalen borttagen, numret större (Björn 2026-09-29). */
  .pstep__n {
    display: block;
    font-stretch: 75%;
    font-weight: 700;
    font-size: var(--fs-lead);
    line-height: 1;
    font-variant-numeric: tabular-nums;
    letter-spacing: 0.04em;
    color: var(--fg-2);
  }
  .pstep__h {
    margin-top: var(--space-5);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-1);
  }
  .pstep__t {
    margin-top: var(--space-3);
    max-width: 30em;
    font-size: var(--fs-lead);
    line-height: 1.6;
    color: var(--fg-2); /* var fg-3: den grå texten förlorade mot kuben */
  }
  .pstep__cta {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-4) var(--space-5);
  }
  .pstep__note {
    font-size: var(--fs-small);
    color: var(--fg-3);
  }

  /* ---- scen: kub + sken ---- */
  /* background: scenen är en egen stapelkontext (isolation), och videons blend-
     läge blandar bara mot det som finns INNE i den → egen bakgrund krävs, annars
     syns videons svarta ruta mot sidans #0a0a0a. */
  .proc__stage {
    position: relative;
    isolation: isolate;
    background: var(--bg);
    display: grid;
    place-items: center;
  }
  .proc__glow {
    position: absolute;
    inset: 12%;
    border-radius: 50%;
    pointer-events: none;
    /* Nyansen glider ~40° med scrollen (indigo → violett), Consolidators färgskifte. */
    background: radial-gradient(
      closest-side,
      hsl(calc(var(--arc-hue) + var(--p) * 40) calc(var(--arc-sat) * 70%) 42% / 0.3),
      transparent 72%
    );
    opacity: calc(0.55 + var(--p) * 0.45);
  }
  /* Stillbild och canvas i samma rutnätscell (ovanpå varandra). */
  .proc__poster,
  .proc__canvas {
    grid-area: 1 / 1;
  }
  .proc__canvas {
    display: none;
  }
  .is-pinned .proc__canvas {
    display: block;
  }
  /* Stillbilden göms först när canvasen ritat sin första bild (scriptet). */
  .proc.has-frames .proc__poster {
    visibility: hidden;
  }
  .proc__video {
    position: relative;
    width: 100%;
    aspect-ratio: 1;
    object-fit: contain;
    display: block;
    mix-blend-mode: lighten;
    /* Kanten tonas ut: kantpixeln hamnar på en bråkdelskoordinat och blandades
       annars till en mörk hårlinje (uppmätt 7 mot 10). Kuben når aldrig ut hit. */
    -webkit-mask-image:
      linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent),
      linear-gradient(180deg, transparent, #000 4%, #000 96%, transparent);
    -webkit-mask-composite: source-in;
    mask-image:
      linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent),
      linear-gradient(180deg, transparent, #000 4%, #000 96%, transparent);
    mask-composite: intersect;
  }

  .proc__rail { display: none; }

  /* ============================================================
     VANLIGT FLÖDE (standard: utan JS, mobil, reduced motion)
     ============================================================ */
  .pstep {
    padding-block: var(--space-6);
    border-top: 1px solid var(--border);
  }
  .proc__viewport { margin-top: var(--space-6); }
  @media (max-width: 859px) {
    .proc__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 0;
    }
    .proc__text { display: contents; }
    .proc__head { order: 1; }
    .proc__visual { order: 2; }
    .proc__viewport { order: 3; margin-top: 0; }
    .proc__stage { margin-block: var(--space-5); }
    .proc__video { max-width: 420px; }
  }

  /* ============================================================
     LÅST LÄGE (.is-pinned, satt av scriptet)
     ============================================================ */
  .proc.is-pinned {
    padding: 0;
    /* 100svh låst ruta + scrollsträckan för stegen. 110svh per steg (var 70): med 70
       stod stegen still 78 % av sträckan och byttes sedan på en kort bit, upp till 5×
       scrollfarten (uppmätt 2026-10-08) → kändes hackigt. */
    height: calc(100svh + (var(--n) - 1) * 110svh + 40svh);
  }
  .is-pinned .proc__pin {
    position: sticky;
    top: 0;
    height: 100svh;
    overflow: hidden;
    padding-top: var(--lock);
    display: flex;
  }
  .is-pinned .proc__grid {
    position: relative;
    isolation: isolate;
    flex: 1;
    min-height: 0;
    width: 100%;
    padding-bottom: var(--space-5);
    grid-template-columns: minmax(0, 1fr);
  }
  /* Allt centrerat (Björn 2026-10-08). */
  .is-pinned .proc__text {
    display: flex;
    flex-direction: column;
    min-height: 0;
    text-align: center;
    position: relative;
    z-index: 1; /* över kuben */
  }
  /* Större text i stegen (Björn 2026-10-08) — de är sektionens huvudsak nu när kuben
     ligger bakom. min(vw, vh): på låga skärmar krymper de så steg 3 med knappen ryms. */
  .is-pinned .pstep__n { font-size: clamp(20px, min(1.9vw, 3.2vh), 28px); }
  .is-pinned .pstep__h { font-size: clamp(38px, min(5.2vw, 8.4vh), 76px); }
  .is-pinned .pstep__t {
    max-width: 26em;
    font-size: clamp(19px, min(1.9vw, 3.1vh), 27px);
    line-height: 1.5;
  }
  .is-pinned .pstep { justify-content: center; }
  .is-pinned .pstep__t { margin-inline: auto; }
  .is-pinned .pstep__cta {
    flex-direction: column;
    justify-content: center;
  }
  .is-pinned .proc__viewport {
    position: relative;
    flex: 1;
    min-height: 0;
    margin-top: 0;
    overflow: hidden;
    /* Stegen tonas ut uppåt (in under rubriken) och nedåt. */
    /* 10 % (var 22 %): större typografi → steg 3 med knappen behöver nästan hela höjden. */
    -webkit-mask-image: linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%);
    mask-image: linear-gradient(180deg, transparent 0, #000 10%, #000 90%, transparent 100%);
  }
  .is-pinned .proc__steps {
    position: absolute;
    inset: 0 0 auto 0;
    will-change: transform;
  }
  .is-pinned .pstep {
    height: var(--slot, 50vh);
    padding: 0;
    border: 0;
    display: flex;
    align-items: center;
  }
  .is-pinned .pstep__inner {
    will-change: opacity, filter;
  }
  /* Scenen = kvadrat, det minsta av kolumnens bredd och höjd (container query).
     Med height:100% blev kuben ~780 px i en ~600 px bred kolumn och klipptes. */
  /* Kuben = nedtonat bakgrundslager bakom innehållet, centrerad i den låsta rutan.
     --cube-dim är satt så att texten klarar kontrastkravet mot kubens ljusaste
     reflexer (mätt mot den rörliga kuben, se docs/progress.md). */
  .is-pinned .proc__visual {
    --cube-dim: 0.2;
    position: absolute;
    inset: 0;
    z-index: 0;
    min-height: 0;
    container-type: size;
    display: grid;
    place-items: center;
    opacity: var(--cube-dim);
    pointer-events: none;
  }
  .is-pinned .proc__stage {
    width: min(100cqw, 96cqh);
    height: min(100cqw, 96cqh);
  }
  .is-pinned .proc__video {
    width: 100%;
    height: 100%;
  }

  /* Låga skärmar (1366×768, 1280×720): stramare avstånd i steget så att steg 3
     (med knappen) ryms i det skarpa området mellan uttoningarna. */
  @media (max-height: 800px) {
    .is-pinned .pstep__h { margin-top: var(--space-3); }
    .is-pinned .pstep__t { margin-top: var(--space-2); }
    .is-pinned .pstep__cta { margin-top: var(--space-4); }
  }

  /* Scroll-indikator: smal kapsel med ett segment per steg. Segmentet för det
     steg som står i mitten lyser, grannarna tonas med avståndet (scriptet sätter
     opacity, samma utjämnade progress som stegen). Consolidator-inspirerad men
     egen: lika långa segment i stället för deras långa streck + prickar. */
  .is-pinned .proc__rail {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 5px;
    position: absolute;
    left: var(--space-4);
    top: 50%;
    transform: translateY(-50%);
    width: 6px;
    padding: 6px 0;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.06);
  }
  .proc__seg {
    width: 2px;
    height: 12px;
    border-radius: 1px;
    background: var(--fg-1);
    opacity: 0.22;
  }
</style>

<script>
  // Låst läge: scroll-progressen genom sektionen (0–1) styr stegens läge, kubens
  // bildruta och --p (skenets nyans + scroll-indikatorn), alla via samma
  // utjämnade värde så de följs åt. Utjämningen (lerp) gör rörelsen mjuk även med
  // hackig hjulscroll. Scrollen i sig är VANLIG: en tidigare dämpning av hjulet
  // gav ett konstigt skifte (trögt i sektionen, snabbt utanför) och är borttagen.
  const section = document.querySelector<HTMLElement>('.proc');
  const canvas = section?.querySelector<HTMLCanvasElement>('.proc__canvas');
  const viewport = section?.querySelector<HTMLElement>('.proc__viewport');
  const list = section?.querySelector<HTMLElement>('.proc__steps');

  if (section && canvas && viewport && list) {
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const wide = window.matchMedia('(min-width: 860px)');
    const steps = Array.from(section.querySelectorAll<HTMLElement>('.pstep'));
    const inners = steps.map((s) => s.querySelector<HTMLElement>('.pstep__inner')!);
    const segs = Array.from(section.querySelectorAll<HTMLElement>('.proc__seg'));
    const n = steps.length;
    // Små dödzoner i början och slutet: första steget står still en stund när
    // rutan låses, och sista steget likaså innan den släpper.
    const LEAD = 0.05;
    const TAIL = 0.07;

    // Kubens bildsekvens (public/proc-cube/f001–f120.webp).
    const FRAMES = 120;
    const frameSrc = (i: number) => `/proc-cube/f${String(i + 1).padStart(3, '0')}.webp`;
    const frames: (HTMLImageElement | null)[] = new Array(FRAMES).fill(null);
    const ctx = canvas.getContext('2d');

    let pinned = false;
    let inView = false;
    let target = 0;
    let shown = 0;
    let raf = 0;
    let slot = 0;
    let vpH = 0;
    let loading = false;
    let drawnOnce = false;

    const clamp = (v: number, a = 0, b = 1) => Math.min(b, Math.max(a, v));

    const measure = () => {
      vpH = viewport.clientHeight;
      // Minst det högsta steget + luft: steg 3 (med knappen) blev högre än 62 % av
      // vyn när typografin växte och spillde in i grannsteget/uttoningen.
      const tallest = Math.max(...inners.map((el) => el.offsetHeight));
      // 0.8 av vyn (var 0.62): mer luft mellan stegen, grannarna syns mindre.
      slot = Math.max(Math.round(vpH * 0.8), tallest + 48);
      section.style.setProperty('--slot', `${slot}px`);
      // Canvasens buffert = visad storlek × skärmens pixeltäthet (max bildernas 900 px).
      const css = canvas.getBoundingClientRect().width;
      const px = Math.round(Math.min(900, css * (window.devicePixelRatio || 1)));
      if (px > 0 && canvas.width !== px) {
        canvas.width = px;
        canvas.height = px;
      }
    };

    const readProgress = () => {
      const r = section.getBoundingClientRect();
      const run = r.height - window.innerHeight;
      const raw = run > 0 ? -r.top / run : 0;
      return clamp((raw - LEAD) / (1 - LEAD - TAIL));
    };

    // Viloläge: varje steg står STILLA och skarpt en del av sin scrollsträcka
    // (HOLD på var sida om mitten) och byter sedan till nästa med en mjuk kurva.
    // Kuben följer däremot den jämna progressen.
    // 0.12 (var 0.28): kort vila → bytet sprids över ~76 % av stegets sträcka och
    // texten rör sig långsammare än scrollen i stället för att fara förbi.
    const HOLD = 0.12;
    const smooth = (x: number) => x * x * (3 - 2 * x);
    const settle = (pos: number) => {
      const i = Math.floor(pos);
      const f = pos - i;
      return i + smooth(clamp((f - HOLD) / (1 - 2 * HOLD)));
    };

    // Närmaste laddade bild (medan sekvensen fortfarande laddas).
    const nearest = (i: number) => {
      for (let d = 0; d < FRAMES; d++) {
        const a = frames[i - d];
        if (a) return a;
        const b = frames[i + d];
        if (b) return b;
      }
      return null;
    };

    // Ritar bildruta f (flyttal): bild floor(f) fullt + nästa bild med alfa =
    // decimalen. Övertoningen gör rörelsen flytande mellan de 120 lägena.
    const drawCube = (p: number) => {
      if (!ctx || !canvas.width) return;
      const f = p * (FRAMES - 1);
      const i = Math.floor(f);
      const t = f - i;
      const a = frames[i] ?? nearest(i);
      if (!a) return;
      const W = canvas.width;
      ctx.globalAlpha = 1;
      ctx.drawImage(a, 0, 0, W, W);
      const b = frames[i + 1];
      if (b && t > 0.01 && frames[i]) {
        ctx.globalAlpha = t;
        ctx.drawImage(b, 0, 0, W, W);
        ctx.globalAlpha = 1;
      }
      if (!drawnOnce) {
        drawnOnce = true;
        section.classList.add('has-frames');
      }
    };

    const render = (p: number) => {
      section.style.setProperty('--p', p.toFixed(4));
      const pos = settle(p * (n - 1)); // stegläge 0…n−1 med vila vid heltalen
      segs.forEach((el, i) => {
        const d = Math.abs(i - pos);
        el.style.opacity = (0.22 + 0.78 * clamp(1 - d * 1.6)).toFixed(3);
      });
      // Steg i (0-baserat) står i mitten när pos = i.
      const offset = vpH / 2 - slot / 2 - pos * slot;
      list.style.transform = `translate3d(0, ${offset.toFixed(1)}px, 0)`;
      inners.forEach((el, i) => {
        const d = Math.abs(i - pos); // avstånd i steg från mitten
        // Helt skarpt nära mitten; tonas och suddas först när steget lämnar den.
        const away = clamp((d - 0.12) / 0.88);
        el.style.opacity = clamp(1 - away * 0.9, 0.08).toFixed(3);
        const blur = away * 3;
        el.style.filter = blur > 0.15 ? `blur(${blur.toFixed(1)}px)` : 'none';
        el.style.transform = `translate3d(0, ${(Math.sign(i - pos) * away * 10).toFixed(1)}px, 0)`;
      });
      drawCube(p);
    };

    const tick = () => {
      raf = 0;
      if (!pinned) return;
      target = readProgress();
      shown += (target - shown) * 0.14;
      if (Math.abs(target - shown) < 0.0005) shown = target;
      render(shown);
      if (shown !== target) raf = requestAnimationFrame(tick);
    };
    const kick = () => {
      if (pinned && inView && !raf) raf = requestAnimationFrame(tick);
    };

    // Laddar sekvensen: först var 8:e bild (grovt men snabbt), sedan resten, med
    // fyra parallella hämtningar. Varje bild avkodas i förväg (decode) så att
    // första ritningen inte hackar.
    const loadFrames = () => {
      if (loading) return;
      loading = true;
      const order: number[] = [];
      for (let i = 0; i < FRAMES; i += 8) order.push(i);
      for (let i = 0; i < FRAMES; i++) if (i % 8) order.push(i);
      let next = 0;
      const worker = async () => {
        while (next < order.length) {
          const idx = order[next++];
          const img = new Image();
          img.src = frameSrc(idx);
          try {
            await img.decode();
            frames[idx] = img;
            if (pinned) render(shown);
          } catch {
            // Enstaka bild som inte laddar: grannbilden används i stället.
          }
        }
      };
      for (let k = 0; k < 4; k++) worker();
    };

    const clearInline = () => {
      list.style.transform = '';
      inners.forEach((el) => {
        el.style.opacity = '';
        el.style.filter = '';
        el.style.transform = '';
      });
      section.style.removeProperty('--p');
      segs.forEach((el) => (el.style.opacity = ''));
    };

    const applyMode = () => {
      const next = wide.matches && !reduced;
      if (next !== pinned) {
        pinned = next;
        section.classList.toggle('is-pinned', pinned);
        if (!pinned) clearInline();
      }
      if (pinned) {
        measure();
        shown = target = readProgress();
        render(shown);
      }
    };

    const observers: IntersectionObserver[] = [];

    // Ladda sekvensen först när sektionen närmar sig, och bara i låst läge
    // (mobil och reduced motion visar stillbilden).
    const loader = new IntersectionObserver(
      (entries) => {
        if (!entries.some((e) => e.isIntersecting) || !pinned) return;
        loader.disconnect();
        loadFrames();
      },
      { rootMargin: '1000px 0px' },
    );
    loader.observe(section);
    observers.push(loader);

    // Lyssna bara på scroll när sektionen är i närheten.
    const near = new IntersectionObserver(
      (entries) => {
        inView = entries.some((e) => e.isIntersecting);
        kick();
      },
      { rootMargin: '200px 0px' },
    );
    near.observe(section);
    observers.push(near);

    const onScroll = () => kick();
    const onResize = () => {
      if (!pinned) return;
      measure();
      render(shown);
    };
    const onModeChange = () => {
      applyMode();
      if (pinned && !loading && inView) loadFrames();
    };
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onResize);
    wide.addEventListener('change', onModeChange);
    applyMode();

    document.addEventListener(
      'astro:before-swap',
      () => {
        observers.forEach((o) => o.disconnect());
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onResize);
        wide.removeEventListener('change', onModeChange);
        if (raf) cancelAnimationFrame(raf);
      },
      { once: true },
    );
  }
</script>
