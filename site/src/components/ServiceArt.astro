---
// ServiceArt.astro – linjeillustrationerna för de fem tjänsteområdena (2026-10-08).
// PLATSHÅLLARE tills vidare (Björn): ersatte Wannathis 3D-ikoner/-videor, som
// kollegorna tyckte inte passade in. Referens: zerotude.io/plattformen (tunna
// linjeillustrationer). Björns val efter fyra skissrundor: "stil 2" = tunna linjer +
// svagt glas i ytorna, en accentfärg, och varje motiv som en liten SCEN med ett
// förlopp. INGET golv/rutnät — djupet kommer av bakre kanter och lager.
//
// Ritade direkt i SVG: skarpa i alla storlekar, följer accent-tokens, inga mediafiler.
// Stående ytor ligger i ett isometriskt plan: matrix(.866,.5,0,1,0,0).
//
// RÖRELSE: förloppet spelas när en förälder har klassen .is-on (Services.astro sätter
// den vid hover/fokus/"syns" på touch) eller när en förälder med .art-trigger hovras.
// Reduced motion: slutläget visas direkt, inga loopar.
//
// compact = bara huvudföremålet, för små ytor (korten på /tjanster, ~110 px).
interface Props {
  id: 'kundtjanst' | 'ekonomi-administration' | 'salj-offert' | 'ai-assistent' | 'kvalitet-projekt';
  compact?: boolean;
}
const { id, compact = false } = Astro.props;

// Utsnitt runt huvudföremålet i compact-läge.
const CROP: Record<Props['id'], string> = {
  kundtjanst: '54 18 136 184',
  'ekonomi-administration': '18 12 96 148',
  'salj-offert': '20 14 134 180',
  'ai-assistent': '28 10 150 206',
  'kvalitet-projekt': '28 10 158 194',
};
const viewBox = compact ? CROP[id] : '0 0 320 220';
---

