          <rect x="40" y="60" width="80" height="28" rx="7" class="a" />
          <circle cx="66" cy="74" r="3" class="dot" /><circle cx="80" cy="74" r="3" class="dot" /><circle cx="94" cy="74" r="3" class="dot" />
        </g>
