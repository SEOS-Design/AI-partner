            <path d="M29 11H88M29 20H72" class="d" /><path d="M11 36H86" class="a n" />
            <rect x="11" y="44" width="38" height="11" rx="5.5" class="a" /><text x="30" y="52.5" text-anchor="middle" class="tx ta tx--s">KÄLLA</text>
          </g>
