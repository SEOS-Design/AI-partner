      <g class="sec">
        <path d="M170 160C190 152 200 126 208 104" class="a ds" />
        <g class="m in">
          <g transform="translate(208,70) matrix(.866,.5,0,1,0,0)">
            <rect x="6" y="-3.5" width="62" height="44" rx="6" class="d" /><rect width="62" height="44" rx="6" class="l" />
            <circle cx="15" cy="15" r="5.5" class="l" /><path d="M6 34a9 9 0 0 1 18 0" class="l n" /><path d="M31 13H54M31 22H46M31 31H50" class="d" />
