---
// Problems.astro – problemsektionen "Var tar tiden vägen?" (Douglas 2026-10-14).
// Ersätter siffersektionen (Stats.astro, se git-historiken) på samma plats.
//
// SICKSACK (2026-10-18, Björns idé efter att kortstapeln förkastats — "ingen finess"):
// rubriken centrerad på EN rad, under den de tre problemen omväxlande till vänster
// och höger. Varje problem glider in från sin egen sida och tonas fram I TAKT MED
// SCROLLEN (GSAP scrub) — och ut igen om man scrollar upp, som rubrik-drapen. Ingen
// låsning, inga lådor. TRÅDEN (2026-10-18, Björn: "som vågen vi gjorde tidigt",
// StartFlow.astro): en glödande linje slingrar sig från rubriken genom mitten, förbi
// varje problem och vidare ned, och RITAS FRAM I TAKT MED SCROLLEN. En punkt tänds
// vid varje problem när linjen når fram. Banan räknas ut i JS efter layouten
// (bygger om vid breddändring). Samma glödlager som vågen: glow · halo · core.
// Sedan, som förut: siffrorna i kompakt form och "Det är där vi kommer in." + svaret
// + knapparna. Problem → belägg → svaret
// (StatsBand.astro, Douglas 2026-10-14 v2): problem → belägg → svaret.
//
// Inga 01–03-nummer på problemen: de är ingen ordningsföljd, och kubsektionen längre
// ner använder 01–03 för de riktiga stegen.
//
// Copy = Douglas (v3 i AI-Partner-startsida-problemsektion-2026-10-14.md, SEOS-mappen;
// texten under "Det är där vi kommer in." = Douglas 2026-10-14).
//
// Mobil: tråden blir en rak linje längs vänsterkanten med punkterna (ingen plats för
// en slinga), problemen under varandra med kortare glidning.
// Reduced motion / utan JS: problemen står på plats direkt.
//
// Rubriken och "Det är där vi kommer in." har sajtens rubrik-drape (data-split, se
// global.css): orden följer scrollen åt båda hållen. Texten och knapparna under
// meningen tonas in en gång.
import Arrow from './Arrow.astro';
import StatsBand from './StatsBand.astro';

const PROBLEMS = [
  {
    title: 'Intern admin och samma frågor',
    body: 'Anteckningar ska bli uppgifter och rapporter ska sammanställas. Och så frågorna: Var hittar jag senaste prislistan? Var ligger avtalsmallen? Hur var det nu vi gjorde med returer?',
  },
  {
    title: 'Marknadsföringen som blev sekundär',
    body: 'Nyhetsbrevet, LinkedIn-inläggen, kundcaset, texterna till den nya tjänstesidan. Allt ligger på någon som egentligen har ett annat jobb. Och det ni skriver med AI är inte tillräckligt bra.',
  },
  {
    title: 'Ni har ingen struktur för AI. Men alla använder det.',
    body: 'Någon kör ChatGPT, någon Copilot, någon Claude. Alla hittar sina egna sätt, ingen delar det som fungerar, och ingen kan svara på frågan: Är det okej att ge AI tillgång till det här? Mycket AI, men inget arbetssätt.',
  },
];

---

<section id="problem" class="probs" aria-labelledby="probs-heading">
  <div class="container probs__wrap">
    <h2 id="probs-heading" class="h2 probs-h" data-split>Var tar tiden vägen?</h2>

    <div class="probs__list">
      {/* Tråden + punkterna: banan sätts av scriptet (dekor, aria-hidden). */}
      <svg class="thread" aria-hidden="true">
        <path class="thread__glow"></path>
        <path class="thread__halo"></path>
        <path class="thread__core"></path>
      </svg>
      {PROBLEMS.map(() => <span class="node" aria-hidden="true"></span>)}

      <ul class="ledger">
        {PROBLEMS.map((p) => (
          <li class="prob">
            <h3 class="prob__title">{p.title}</h3>
            <p class="prob__body">{p.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </div>

  {/* Siffrorna i kompakt form. */}
  <StatsBand />

  {/* Rubrik-drapen (data-split, global.css): orden glider upp i takt med scrollen. */}
  <div class="statement-track">
    <p class="statement" data-split>Det är där vi kommer in.</p>
    <div class="statement-more">
      <p class="statement-more__text">
        Vi bygger <a href="/kunskapsbank/vad-ar-en-ai-agent">AI-agenter</a> och
        <a href="/kunskapsbank/vad-ar-rpa">automation</a> som tar det repetitiva, så att era medarbetare
        kan lägga tiden där den gör skillnad. Utgångspunkten är era egna processer och data.
        Vi automatiserar enbart det som faktiskt lönar sig och sparar er tid – tack vare
        rätt kontext, data och guardrails.
      </p>
      <div class="statement-more__cta">
        <a class="btn btn-primary" href="/kontakt">Boka kartläggning <Arrow class="arrow" /></a>
        <a class="btn btn-glass" href="/om-oss">Mer om oss <Arrow class="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Raised band — lyfter sektionen från void-sektionerna runtom. */
  .probs {
    padding: var(--section-py) 0;
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }
  .container {
    max-width: var(--maxw-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  /* ---- Rubriken: centrerad, EN rad ---- */
  .probs__wrap {
    container-type: inline-size; /* rubrikens storlek räknas mot bredden (cqi) */
  }
  /* ~6,75 em bred → krymper med bredden när h2-storleken inte ryms. */
  .probs-h {
    margin: 0;
    font-size: min(var(--fs-h2), calc(100cqi / 6.9));
    line-height: 1.1;
    white-space: nowrap;
    text-align: center;
  }
  .probs {
    overflow-x: clip; /* problemen glider in från utanför kanten */
  }

  /* ---- Sicksack ---- */
  .probs__list {
    position: relative;
    margin-top: clamp(56px, 8vw, 120px);
  }
  .ledger {
    position: relative;
    z-index: 1;
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: clamp(64px, 8vw, 128px);
  }
  /* Smalare block än halva bredden → en mittgata där tråden slingrar sig. */
  .prob {
    position: relative;
    width: min(100%, 40%, 30rem);
    will-change: transform, opacity;
  }
  .prob:nth-child(even) {
    justify-self: end;
  }
  .prob__title {
    font-stretch: 75%;
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-1);
    text-wrap: balance;
  }
  .prob__body {
    margin: var(--space-4) 0 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--fg-2);
    text-wrap: pretty;
  }

  /* ---- Tråden (samma glödlager som vågen i StartFlow.astro) ---- */
  .thread {
    position: absolute;
    inset: 0;
    z-index: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    pointer-events: none;
  }
  .thread path {
    fill: none;
    stroke-linecap: round;
    /* Längden sätts av scriptet (dasharray = banans längd i px); utan JS döljs
       tråden helt (se .has-thread). */
  }
  .thread__glow {
    stroke: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 58% / 0.16);
    stroke-width: 14;
    filter: blur(6px);
  }
  .thread__halo {
    stroke: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 62% / 0.35);
    stroke-width: 4;
  }
  .thread__core {
    stroke: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 82%);
    stroke-width: 1.5;
    filter: drop-shadow(0 0 4px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 66% / 0.9));
  }
  /* Punkten vid varje problem: släckt tills linjen når fram (.is-lit). */
  .node {
    position: absolute;
    z-index: 0;
    left: 0;
    top: 0;
    width: 12px;
    height: 12px;
    margin: -6px 0 0 -6px;
    border-radius: 50%;
    background: #1c1b2c;
    border: 1px solid hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 70% / 0.45);
    transition: background-color 0.35s var(--ease), box-shadow 0.35s var(--ease), border-color 0.35s var(--ease);
  }
  .node.is-lit {
    background: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 92%);
    border-color: #fff;
    box-shadow:
      0 0 0 4px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 60% / 0.18),
      0 0 14px 3px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 62% / 0.8),
      0 0 30px 6px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 56% / 0.45);
  }
  /* Utan JS: ingen bana → dölj tråd och punkter. */
  .probs__list:not(.has-thread) .thread,
  .probs__list:not(.has-thread) .node {
    display: none;
  }

  /* Mobil: problemen under varandra, tråden rak längs vänsterkanten. */
  @media (max-width: 859px) {
    .ledger { padding-left: 32px; }
    .prob,
    .prob:nth-child(even) {
      width: 100%;
      justify-self: stretch;
    }
    /* Smalare sken (Björn: för brett/konstig skuggning längs den raka linjen):
       inget suddigt glödlager, tunnare halo, mindre sken runt punkterna. */
    .thread__glow { display: none; }
    .thread__halo { stroke-width: 3; stroke: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 62% / 0.25); }
    .thread__core { filter: drop-shadow(0 0 2px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 66% / 0.8)); }
    .node { width: 10px; height: 10px; margin: -5px 0 0 -5px; }
    .node.is-lit {
      box-shadow:
        0 0 0 3px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 60% / 0.16),
        0 0 8px 1px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 62% / 0.7);
    }
  }

  /* ---- Slutmeningen ---- */
  .statement {
    font-stretch: 75%;
    margin: 0;
    font-weight: 700;
    /* ALLTID EN RAD (Björn 2026-10-16: Safari bröt "Det / är där vi kommer in.").
       Meningen är ~7,7 em bred → krymper med kolumnen när h2-storleken inte ryms. */
    font-size: min(var(--fs-h2), calc(100cqi / 7.9));
    white-space: nowrap;
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-display);
    color: var(--fg-1);
    text-align: center;
  }
  .statement-more {
    max-width: 44em;
    margin: clamp(24px, 3vw, 40px) auto 0;
    text-align: center;
  }
  /* Länkar till kunskapsbanken i texten (2026-10-24): tunn underkant som Story-länken. */
  .statement-more__text a {
    color: var(--fg-1);
    border-bottom: 1px solid var(--border-strong);
    padding-bottom: 1px;
    transition: border-color var(--dur-fast) var(--ease);
  }
  .statement-more__text a:hover {
    border-color: var(--fg-1);
  }
  .statement-more__text {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--fg-2);
    text-wrap: pretty;
  }
  .statement-more__cta {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
  /* Standard (mobil): vanlig rad med luft omkring. */
  .statement-track {
    container-type: inline-size; /* meningens storlek räknas mot sin bredd (cqi) */
    padding: clamp(56px, 8vw, 112px) var(--space-5) 0;
  }
  /* Bred skärm: lika mycket luft ovanför meningen som under sektionen. */
  @media (min-width: 860px) {
    .probs {
      --gap: var(--space-7);
      --run: 16svh;
      padding-bottom: calc(var(--gap) + var(--run));
    }
    .statement-track {
      padding: calc(var(--gap) + var(--run)) var(--space-5) 0;
    }
    .statement {
      white-space: nowrap;
    }
  }

  /* ---- animation (bara när scriptet satt .will-reveal) ---- */
  /* Texten och knapparna tonas in en gång när meningen nått in i bild (ingen
     scrollanimation på brödtext — Björns regel). */
  .statement-track.will-reveal .statement-more {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.6s var(--ease), transform 0.6s var(--ease);
    /* 0.15 s (var 0.9 s): väntan + tonen tog nästan 2 s innan texten syntes
       (Björn 2026-10-18). Meningens ord sköts av drapen, inte av den här fördröjningen. */
    transition-delay: 0.15s;
  }
  .statement-track.will-reveal.is-in .statement-more {
    transform: none;
    opacity: 1;
  }
</style>

<script>
  import { gsap } from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Sicksacken: varje problem glider in från sin sida (udda vänster, jämna höger)
  // och tonas fram i takt med scrollen — och ut igen åt andra hållet.
  // Tråden: banan räknas ut från problemrubrikernas lägen och ritas fram i takt med
  // scrollen; punkten vid varje problem tänds när linjen passerat den.
  const list = document.querySelector<HTMLElement>('.probs .probs__list');
  const ledger = list?.querySelector<HTMLElement>('.ledger');
  if (list && ledger) {
    const probs = Array.from(ledger.querySelectorAll<HTMLElement>('.prob'));
    const titles = probs.map((p) => p.querySelector<HTMLElement>('.prob__title')!);
    const nodes = Array.from(list.querySelectorAll<HTMLElement>('.node'));
    const paths = Array.from(list.querySelectorAll<SVGPathElement>('.thread path'));
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let fracs: number[] = [];
    let drawn = reduced ? 1 : 0;
    let total = 0;
    let nodeY: number[] = []; // punkternas y i listan — styr när tråden ritas

    // Ritar fram p (0–1) av tråden: dashoffset i riktiga px. (GSAP avrundar px-värden
    // till hela pixlar — med pathLength=1 hoppade tråden direkt från 0 till 1, Björn:
    // "dyker bara upp helt plötsligt". Därför sätts värdet här, inte via en tween.)
    const draw = (p: number) => {
      drawn = p;
      const off = (total * (1 - p)).toFixed(1);
      paths.forEach((el) => (el.style.strokeDashoffset = off));
      // Första punkten tänds när tråden börjar, de andra när den når fram.
      nodes.forEach((n, i) =>
        n.classList.toggle('is-lit', i === 0 ? p > 0 : p >= (fracs[i] ?? 2) - 0.002),
      );
    };

    // Bygger banan i listans koordinater (bredd/höjd i px = SVG:ns egna enheter).
    const build = () => {
      // offset* (layoutläget), inte getBoundingClientRect: blocken kan vara förskjutna
      // av glidanimationen just när banan byggs.
      const wide = window.innerWidth >= 860;
      const pts = probs.map((p, i) => {
        const fs = parseFloat(getComputedStyle(titles[i]).fontSize);
        const y = ledger.offsetTop + p.offsetTop + titles[i].offsetTop + fs * 0.55; // rubrikens första rad
        // Desktop: punkten på blockets insida (mot mitten); mobil: vänsterkanten.
        const left = ledger.offsetLeft + p.offsetLeft;
        const x = !wide ? 8 : i % 2 ? left - 36 : left + p.offsetWidth + 36;
        return { x, y };
      });
      // Tråden går från första till sista punkten (Björn 2026-10-18).
      const all = pts;
      const start = pts[0];
      nodeY = pts.map((p) => p.y);
      let d = `M${start.x},${start.y}`;
      for (let i = 1; i < all.length; i++) {
        const a = all[i - 1];
        const b = all[i];
        const k = (b.y - a.y) * 0.5; // lodräta tangenter → mjuk S mellan punkterna
        d += ` C${a.x},${a.y + k} ${b.x},${b.y - k} ${b.x},${b.y}`;
      }
      paths.forEach((p) => p.setAttribute('d', d));
      // Hur långt längs banan varje punkt ligger (0–1).
      const probe = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      probe.setAttribute('d', d);
      total = probe.getTotalLength();
      paths.forEach((el) => (el.style.strokeDasharray = `${total} ${total}`));
      let acc = `M${start.x},${start.y}`;
      fracs = pts.map((_, i) => {
        if (i === 0) return 0;
        const a = all[i - 1];
        const b = all[i];
        const k = (b.y - a.y) * 0.5;
        acc += ` C${a.x},${a.y + k} ${b.x},${b.y - k} ${b.x},${b.y}`;
        probe.setAttribute('d', acc);
        return probe.getTotalLength() / total;
      });
      nodes.forEach((n, i) => {
        n.style.left = `${pts[i].x}px`;
        n.style.top = `${pts[i].y}px`;
      });
      list.classList.add('has-thread');
      draw(drawn);
    };

    build();
    document.fonts?.ready.then(() => { build(); ScrollTrigger.refresh(); });
    let lastW = window.innerWidth;
    window.addEventListener('resize', () => {
      if (window.innerWidth === lastW) return;
      lastW = window.innerWidth;
      build();
    });

    const mm = gsap.matchMedia();
    mm.add(
      {
        wide: '(min-width: 860px) and (prefers-reduced-motion: no-preference)',
        narrow: '(max-width: 859px) and (prefers-reduced-motion: no-preference)',
      },
      (ctx) => {
        // Glidningen bara på desktop (Björn 2026-10-18: på mobil "blir det lite
        // mycket" — där står problemen still och bara tråden ritas fram).
        if (ctx.conditions?.wide) {
          probs.forEach((el, i) => {
            gsap.fromTo(
              el,
              { x: (i % 2 ? 1 : -1) * 140, opacity: 0 },
              {
                x: 0,
                opacity: 1,
                ease: 'power2.out',
                scrollTrigger: { trigger: el, start: 'top 92%', end: 'top 58%', scrub: true },
              },
            );
          });
        }
        // Linjen: från att första punkten når 75 % av vyn tills sista punkten når
        // 50 %. Progressen direkt (Lenis jämnar redan ut scrollen med mus/styrplatta).
        const st = ScrollTrigger.create({
          trigger: list,
          start: () => `top+=${nodeY[0] ?? 0} 75%`,
          end: () => `top+=${nodeY[nodeY.length - 1] ?? 0} 50%`,
          onUpdate: (self) => draw(self.progress),
          onRefresh: (self) => draw(self.progress),
        });
        draw(st.progress);
        return () => draw(1); // lämnar läget (t.ex. reduced motion) → färdigritad
      },
    );
    window.addEventListener('load', () => { build(); ScrollTrigger.refresh(); }, { once: true });
    document.addEventListener('astro:before-swap', () => mm.revert(), { once: true });
  }

  // Texten och knapparna under meningen tonas in när meningen scrollas in (orden
  // sköts av rubrik-drapen). Utan JS och vid reduced motion syns meningen direkt; .will-reveal (dolt läge)
  // sätts först när scriptet vet att det kan animera.
  const track = document.querySelector<HTMLElement>('.probs .statement-track');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (track && !reduced && 'IntersectionObserver' in window) {
    const statement = track.querySelector('.statement');
    // Redan i vyn vid laddning → visa direkt, ingen animation.
    const r = statement?.getBoundingClientRect();
    if (statement && r && r.top > window.innerHeight * 0.85) {
      track.classList.add('will-reveal');
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          track.classList.add('is-in');
          io.disconnect();
        },
        // Startar när meningen nått ungefär 10 % upp i bild (var 20 %).
        { rootMargin: '0px 0px -10% 0px' },
      );
      io.observe(statement);
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    }
  }
</script>
