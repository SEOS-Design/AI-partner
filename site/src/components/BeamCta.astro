---
// BeamCta.astro – frostad glas-CTA ("Till SEOS Design" i Team) med en (pausad)
// komet längs kanten. Glas-looken = den delade .btn-glass i global.css.
//
// Kometen = flera tunna stroke-segment med fallande opacitet + fas-förskjutning
// som bildar EN uttonande strimma; banan ritas i JS efter knappens exakta mått
// (rundad rektangel, ResizeObserver).
// Bygger på .btn-basen (global.css) så den paras jämnt med .btn-primary.
// Innehåll (text + ev. Arrow) skickas via <slot>.
interface Props {
  href: string;
  target?: string;
  rel?: string;
  class?: string;
}
const { href, target, rel, class: className } = Astro.props;

// Komet-segment: front ljusast & leder (mest negativ delay), bakre svagast.
const COMET = [
  { op: 0.62, delay: '-0.42s' },
  { op: 0.48, delay: '-0.35s' },
  { op: 0.36, delay: '-0.28s' },
  { op: 0.26, delay: '-0.21s' },
  { op: 0.17, delay: '-0.14s' },
  { op: 0.1, delay: '-0.07s' },
  { op: 0.05, delay: '0s' },
];
---

<a class:list={['btn', 'btn-glass', 'beam-cta', className]} href={href} target={target} rel={rel}>
  <slot />
  {/* KOMET PAUSAD 2026-07-17 — fungerar inte mot den vita ytan. Mot svart var den
      en ljus strimma som lyste ut i mörkret; mot vitt finns inget mörker att lysa i,
      och även på sin mest mättade punkt (#0099ff) blir den ett streck snarare än ett
      sken. Återställ: avkommentera <span> nedan. CSS + <script> ligger kvar och
      no-op:ar utan segment (scriptet returnerar på `if (!paths.length)`). */}
  {/*
  <span class="beam-cta__beam" aria-hidden="true">
    <svg class="beam-cta__svg" aria-hidden="true">
      {COMET.map((s) => (
        <path class="beam-cta__seg" pathLength="100" style={`--op:${s.op};--delay:${s.delay}`}></path>
      ))}
    </svg>
  </span>
  */}
</a>

<style>
  /* Glas-looken (bakgrund, blur, kant, skuggor, hover) ligger i den delade
     .btn-glass i global.css sedan sept 2026 — samma knapp används nu även för
     nav-CTA:n och Positioneringens CTA:er. Här bara det kometen behöver. */
  .beam-cta {
    position: relative;
    isolation: isolate;
  }

  /* Komet: flera tunna stroke-segment (front ljus → bakre transparent). */
  .beam-cta__beam {
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    z-index: 2;
    overflow: visible; /* låt glöden stråla utanför kanten */
  }
  .beam-cta__svg {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    overflow: visible;
    fill: none;
  }
  /* Värdena gäller den MÖRKA glasytan: het nästan vit kärna (88% ljushet) med en
     glöd som lyser ut i mörkret — StartFlows neon-recept. (Kometen låg kortvarigt
     på 50% ljushet när knappen var vit; mot vitt är det den enda ljushet som syns,
     men mot glas blir den ett dovt streck. Byt tillbaka till 50% om knappen
     någonsin blir ljus igen.)
     Renderas inte just nu — segmenten är bortkommenterade i markupen. */
  .beam-cta__seg {
    fill: none;
    stroke: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 88%);
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-dasharray: 2.6 97.4;
    stroke-dashoffset: 0;
    opacity: var(--op, 0.5);
    filter:
      drop-shadow(0 0 3px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 70% / 0.85))
      drop-shadow(0 0 9px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 58% / 0.5));
    animation: beamComet 5.5s linear infinite;
    animation-delay: var(--delay, 0s);
  }
  @keyframes beamComet {
    to {
      stroke-dashoffset: -100;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .beam-cta__beam {
      display: none;
    }
  }
</style>

<script>
  // Rita banan som en rundad rektangel i knappens exakta pixelmått så strimman
  // följer kanten (inkl. hörnradien). ResizeObserver håller banan i synk.
  (function () {
    const btns = document.querySelectorAll<HTMLElement>('.beam-cta');
    if (!btns.length) return;
    const observers: ResizeObserver[] = [];
    btns.forEach((btn) => {
      const paths = btn.querySelectorAll<SVGPathElement>('.beam-cta__seg');
      if (!paths.length) return;
      const inset = 0.5; // border-mittlinjen (1px border → 0.5px inset)
      const sync = (): void => {
        const w = btn.clientWidth;
        const h = btn.clientHeight;
        const x = inset;
        const y = inset;
        const bw = Math.max(0, w - inset * 2);
        const bh = Math.max(0, h - inset * 2);
        const r = Math.max(0, Math.min(21.5, bw / 2, bh / 2));
        const cx = x + bw / 2;
        const d =
          `M${cx},${y + bh} H${x + r} A${r},${r} 0 0 1 ${x},${y + bh - r}` +
          ` V${y + r} A${r},${r} 0 0 1 ${x + r},${y}` +
          ` H${x + bw - r} A${r},${r} 0 0 1 ${x + bw},${y + r}` +
          ` V${y + bh - r} A${r},${r} 0 0 1 ${x + bw - r},${y + bh}` +
          ` H${cx} Z`;
        paths.forEach((p) => p.setAttribute('d', d));
      };
      sync();
      const ro = new ResizeObserver(sync);
      ro.observe(btn);
      observers.push(ro);
    });
    document.addEventListener(
      'astro:before-swap',
      () => observers.forEach((o) => o.disconnect()),
      { once: true },
    );
  })();
</script>
