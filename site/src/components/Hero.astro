---
// Hero.astro – Heron som glas-box med bakgrundsbild, mot svart.
// Tokens och font-import hanteras i styles/global.css (via Layout.astro).
// CTA:erna är FLYTTADE till Positionering-sektionen (heron är nu ren, utan knappar).
// Komet-sekundären lever vidare där via den delade BeamCta.astro.
//
// Boxen porterad från mockup-sidan /hero-mockup (numera raderad) 2026-07-16.
// Partikelnätet är FLYTTAT till Positionering.astro 2026-07-17 — det är inte längre
// en no-op här, utan bor i den sektionen med sin CSS och sitt script.
---

<section class="hero" aria-label="AI Partner">
  <div class="hero-box">
    {/* Bakgrund: glas-loop (Wannathis "Abstract objects", dark theme — 4K-källa
        nedskalad till 1920 + komprimerad, se site/public/hero-glass.*). Skarven
        mätt sömlös (kvot 1,51). Videon ligger på z1; postern (.hero-bg, z0) är
        första rutan och visas innan videon laddat OCH vid reduced-motion, då
        videon döljs. Den gamla /hero-bg.webp är kvar i public/ för återbruk. */}
    {/* Ingen autoplay: inview-video.ts spelar den när den syns och pausar den när
        man scrollat förbi. preload="auto" så den är buffrad direkt (hero syns först). */}
    <video
      class="hero-video"
      data-inview-video
      preload="auto"
      muted
      loop
      playsinline
      poster="/hero-glass-poster.webp"
      aria-hidden="true"
    >
      <source src="/hero-glass.webm" type="video/webm" />
      <source src="/hero-glass.mp4" type="video/mp4" />
    </video>
    <div class="hero-bg" aria-hidden="true"></div>

    {/* Glasets färg + läsbarhetsskydd. Ersätter den gamla .hero-veil, som satt på
        hela sektionen. Styrkan är satt för MESHEN — se kommentaren vid .hero-tint. */}
    <div class="hero-tint" aria-hidden="true"></div>

    <!-- Centrerat rubrikblock -->
    <div class="hero-center">
      <!-- H1: "AI" och "Partner" glider upp vid inladdning -->
      <h1 class="hero-title">
        <span class="hero-title__line">
          <span class="hero-title__in" data-text="AI">AI</span>
        </span>
        <span class="hero-title__line">
          <span class="hero-title__in" data-text="PARTNER">PARTNER</span>
        </span>
      </h1>
      {/* Budskapet (2026-10-08, efter avstämning): flyttat hit från Positionering-
          sektionen, som låg direkt under heron och blev för mycket ihop med den
          rörliga heron. Står vänsterställt direkt OVANFÖR rubriken (Björns val
          "staplat till vänster"; bredvid rubriken på samma baslinje kändes
          obalanserat). H1 kommer först i DOM:en och glider in först. */}
      <h2 class="hero-sub-title">
        Vi bygger AI-agenter och automation som tar rutinarbetet.
      </h2>
    </div>
  </div>
</section>

<style>
  .hero {
    /* Måtten speglar SEOS-heron (uppmätt på seosdesign.se: 10px marginal runt om,
       32px radie, 97,2% × 97,2% av skärmen — deras .background-video-wrap).
       Navbaren hamnar då HELT innanför boxen, vilket är poängen: det som skavde
       tidigare var inte att den låg på glaset, utan att den satt grensle över
       kanten med halva sig i svart. */
    --edge: 10px;
    --radius: 32px;

    position: relative;
    min-height: 100svh;
    padding: var(--edge);
    overflow: hidden;
    background: var(--bg);
    isolation: isolate;
  }

  /* Ligger under tinten (z 2) — tinten dämpar bilden och skyddar läsbarheten bakom
     rubriken, samma roll som den gamla .hero-veil hade för meshen. */
  .hero-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: inherit;
    /* = videons poster (första rutan). Fallback bakom videon och synlig vid
       reduced-motion, då .hero-video döljs nedan. */
    background-image: url("/hero-glass-poster.webp");
    background-size: cover;
    background-position: center;
    background-repeat: no-repeat;
  }

  /* Glas-loopen. Ligger över postern men under tinten (z2), så tinten dämpar
     den och skyddar läsbarheten bakom rubriken — precis som mot den gamla
     bilden. object-fit: cover fyller boxen på alla proportioner. */
  .hero-video {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: inherit;
    display: block;
  }
  /* Rörelse är förstärkning, aldrig förutsättning: vid reduced-motion döljs
     videon och postern (.hero-bg) står kvar som stilla bild. */
  @media (prefers-reduced-motion: reduce) {
    .hero-video { display: none; }
  }

  /* Strålkastarljusen (.hero-aura / .hero-src) BORTTAGNA 2026-07-17 på Björns
     begäran. De hörde till silkes- och Spline-experimenten och behövs inte med
     meshen, som bär sitt eget ljus. */

  /* ══════════ GLAS-BOXEN ══════════ */
  .hero-box {
    position: relative;
    z-index: 1;
    min-height: calc(100svh - var(--edge) * 2);
    display: grid;
    /* Rubriken längs nederkanten, vänsterställd (Björn 2026-09-29, fundamental.bg-ref). */
    place-items: end start;
    padding: clamp(96px, 14vh, 140px) clamp(20px, 3.4vw, 48px) clamp(14px, 2.2vw, 30px);
    border-radius: var(--radius);
    overflow: hidden;
    /* Boxens egen yta — syns bara innan bilden laddat, och i eventuella glipor. */
    background: #06070a;
    /* SKUGGAN BORTTAGEN 2026-07-17. Var en svart slagskugga + en azur ytterglöd;
       med bara 10px marginal mot sidans svarta hade ingen av dem någon yta att
       landa i, och glöden motsade dessutom den nya gråa kanten. */
  }
  /* Glasets kant — samma gråa hårstreck som navbaren och resten av sidan
     (--border-strong, dvs vitt på 18%). Var tidigare en azur conic-gradient
     maskad till en 1,5px rim; den byttes ut 2026-07-17 för att följa
     design-systemets kant i stället för att ha en egen.

     Ligger på ::after i stället för som `border` på .hero-box, så den inte
     påverkar layouten — och ovanpå bild och tint, så den aldrig dämpas. */
  .hero-box::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 5;
    border-radius: inherit;
    pointer-events: none;
    border: 1px solid var(--border-strong);
  }

  /* Silkesvideons CSS borttagen med videon. Ska den tillbaka:
     .hero-video { position:absolute; inset:0; z-index:0; width:100%; height:100%;
       object-fit:cover; display:block;
       filter: brightness(1.06) contrast(1.16) saturate(0.9); }
     Filtret var mätt: källan låg 99% under luminans 51 och skulle inte dämpas utan
     koncentreras — kontrasten kröker ner mellantonerna och blåser upp
     specular-topparna på vecken. */

  /* ══════════ TINT + SLÖJA ══════════
     Tinten ger glaset dess färg och dämpar bilden bakom rubriken.
     Center-radialen LÄTTAD 0.82 → 0.68 (2026-09) så glas-loopen syns mer; var
     tidigare satt för partikelnätet. Kontrasten är OMMÄTT mot den rörliga videon
     över hela loopen (Playwright, värsta rutan, vit text vs bakgrund).
     2026-09-29, rubriken längs nederkanten + mörk övertoning nedifrån: H1 värsta
     pixel 8,7 (1920) / 10,0 (1440) / 16,8 (390), krav 3,0; underrubrik (fg-2, högerställd
     ovanför rubriken, en rad) 6,7 / 7,7 / 9,8, krav 4,5.
     Den bindande gränsen är den ljusaste specular-pixeln bakom texten, INTE
     snittet: mät den (max, inte bara medel) om du lättar tinten mer. */
  .hero-tint {
    position: absolute;
    inset: 0;
    z-index: 2;
    border-radius: inherit;
    pointer-events: none;
    background:
      /* Rubriken ligger nu längs nederkanten → mörkt nedifrån i stället för i mitten. */
      linear-gradient(0deg, rgba(6, 7, 10, 0.82) 0%, rgba(6, 7, 10, 0.62) 44%, rgba(6, 7, 10, 0) 72%),
      radial-gradient(ellipse 72% 58% at 34% 84%, rgba(6, 7, 10, 0.45) 0%, rgba(6, 7, 10, 0) 76%),
      radial-gradient(120% 100% at 50% 50%, transparent 52%, rgba(4, 5, 7, 0.48) 100%),
      linear-gradient(180deg, rgba(255, 255, 255, 0.05), rgba(255, 255, 255, 0.01) 30%, transparent 56%),
      hsl(var(--arc-hue) calc(var(--arc-sat) * 24%) 7% / 0.20);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, 0.16);
  }

  .hero-center {
    position: relative;
    z-index: 4;
    width: 100%;
    container-type: inline-size; /* rubrikens storlek räknas från den här bredden */
    text-align: left;
    /* Allt samlat nere till vänster: budskapet ovanför rubriken, höger sida åt videon. */
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: clamp(14px, 2.2cqi, 30px);
  }

  .hero-title {
    font-family: var(--font-sans);
    font-weight: 700;
    /* EN rad som fyller boxens bredd (Björn 2026-09-29; var två centrerade rader). */
    /* "AI PARTNER" är ~3,46 em bred (ordmellanrummet kommer från markupens blanksteg) → 100cqi / 3,47 fyller raden kant till kant
       (uppmätt: lika luft vänster/höger vid 1440 och 1920). */
    /* Ca 81 % av bredden (100cqi / 4.27): stor nog att dominera, men inte kant till
       kant — luften till höger ger asymmetrin. Mobil: full bredd (media-regeln nedan). */
    font-size: calc(100cqi / 4.27);
    line-height: 0.8;
    letter-spacing: -0.04em;
    white-space: nowrap;
    margin-bottom: -0.04em; /* bokstävernas fot nära boxens nederkant */
    color: var(--fg-1);
  }

  .hero-title__line { display: inline-block; }

  .hero-title__in {
    position: relative;
    display: inline-block;
    color: var(--fg-1);
    will-change: transform, opacity;
  }

  /* Glint-overlay: ett ljusskimmer sveper över bokstäverna via en overlappande kopia.
     Basen i vitt är alltid synlig — kopian målar bara skimret ovanpå. */
  .hero-title__in::after {
    content: attr(data-text);
    position: absolute;
    left: 0;
    top: 0;
    pointer-events: none;
    color: transparent;
    background-image: linear-gradient(105deg, transparent 42%, rgba(255,255,255,0.85) 50%, transparent 58%);
    background-repeat: no-repeat;
    background-size: 220% 100%;
    background-position: 135% 0;
    -webkit-background-clip: text;
    background-clip: text;
  }

  /* Budskapet: smalt och vänsterställt direkt ovanför rubriken (visuellt först,
     men efter H1 i DOM:en och i animationen). */
  .hero-sub-title {
    order: -1;
    max-width: 26ch;
    margin: 0;
    padding-left: 0.12em; /* optiskt i linje med rubrikens A */
    font-family: var(--font-sans);
    font-size: clamp(24px, 3.9cqi, 54px);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.01em;
    text-align: left;
    text-wrap: balance;
    color: var(--fg-1);
  }
  /* Smal skärm: rubriken kant till kant. */
  @media (max-width: 760px) {
    .hero-title {
      font-size: calc(100cqi / 3.47);
    }
    .hero-sub-title {
      max-width: 18ch;
    }
  }

  /* ---- Keyframes ---- */
  @keyframes titleRise {
    from { opacity: 0; transform: translateY(0.42em); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @keyframes titleGlint {
    0%        { background-position: 135% 0; }
    30%, 100% { background-position: -35% 0; }
  }

  /* ---- Entrance-animationer (pausas om användaren föredrar reducerad rörelse) ---- */
  @media (prefers-reduced-motion: no-preference) {
    .hero-title__in {
      opacity: 0;
      transform: translateY(0.42em);
      animation: titleRise 1s cubic-bezier(0.16, 0.84, 0.32, 1) forwards;
    }
    .hero-title__line:nth-child(1) .hero-title__in { animation-delay: .42s; }
    .hero-title__line:nth-child(2) .hero-title__in { animation-delay: .55s; }

    /* Budskapet kommer kort efter rubriken (Björn 2026-10-08: H1 först, sedan texten). */
    .hero-sub-title {
      opacity: 0;
      transform: translateY(0.6em);
      animation: titleRise 0.9s cubic-bezier(0.16, 0.84, 0.32, 1) 0.95s forwards;
    }

    .hero-title__in::after { animation: titleGlint 6.5s ease-in-out 1.9s infinite; }
    .hero-title__line:nth-child(2) .hero-title__in::after { animation-delay: 2.05s; }
  }

</style>

<script>
  import '../scripts/inview-video';
</script>
