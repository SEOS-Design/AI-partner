<style>
  .art {
    --line: #dcdce8;
    --acc: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 78%);
    --acc-fill: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 70% / 0.22);
    display: block;
    width: 100%;
    height: 100%;
    overflow: visible;
  }
  .art--compact .sec { display: none; }

  /* ---- linjer och ytor ("stil 2": linjer + svagt glas) ---- */
  .l, .d, .a {
    stroke-width: 1.1;
    vector-effect: non-scaling-stroke; /* samma tunna linje i alla storlekar */
    stroke-linejoin: round;
    stroke-linecap: round;
  }
  .l { stroke: var(--line); stroke-opacity: 0.85; fill: rgba(255, 255, 255, 0.055); }
  .d { stroke: var(--line); opacity: 0.3; fill: none; }
  .a { stroke: var(--acc); fill: var(--acc-fill); }
  .n { fill: none; }
  .dot { fill: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 84%); stroke: none; }
  .wd { fill: var(--line); opacity: 0.6; stroke: none; }
  .tx {
    font-family: var(--font-sans);
    font-stretch: 75%;
    font-weight: 700;
    font-size: 8.5px;
    letter-spacing: 0.06em;
    fill: var(--line);
    opacity: 0.8;
    stroke: none;
  }
  .tx--s { font-size: 7px; }
  .ta { fill: hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 86%); opacity: 1; }

  /* ---- viloläge (innan förloppet spelas) ---- */
  .m {
    transition: transform 0.7s var(--ease), opacity 0.6s var(--ease);
    transform-box: fill-box;
  }
  .dr {
    fill: none;
    stroke-dasharray: 170;
    stroke-dashoffset: 170;
    transition: stroke-dashoffset 1s var(--ease);
  }
  .ds {
    fill: none;
    stroke-dasharray: 4 4;
    opacity: 0;
    transition: opacity 0.5s var(--ease) 0.3s;
  }
  .up { transform: translateY(6px); }
  .in { transform: translate(14px, 8px); opacity: 0.22; }
  .ch { transform: translateY(6px); opacity: 0.2; }
  .hl { opacity: 0; transition: opacity 0.5s var(--ease) 0.3s; }
  .b1, .b2, .b3 { transform: scaleX(0.25); transform-origin: left; }
  .spin { transform-origin: center; transform-box: fill-box; }
  .c3 { transition-delay: 0.9s; }
  /* Längre linjer som skrivs fram (Marknad): streckmönstret måste vara längre än
     linjen i skärmpixlar, annars syns en bit i vila. */
  .dl { stroke-dasharray: 320; stroke-dashoffset: 320; }
  .w2 { transition-delay: 0.25s; }
  .w3 { transition-delay: 0.5s; }
  .c4 { transition-delay: 1.4s; }

  /* ---- förloppet: förälder .is-on, eller hovrad .art-trigger ---- */
  :global(:is(.is-on, .art-trigger:hover)) .dr { stroke-dashoffset: 0; }
  :global(:is(.is-on, .art-trigger:hover)) .ds { opacity: 1; }
  :global(:is(.is-on, .art-trigger:hover)) .up { transform: none; }
  :global(:is(.is-on, .art-trigger:hover)) .in { transform: none; opacity: 1; transition-delay: 0.4s; }
  :global(:is(.is-on, .art-trigger:hover)) .ch { transform: none; opacity: 1; transition-delay: 0.8s; }
  /* Kort som kommer efter varandra (Intern admin) och en bock som väntar in dem. */
  :global(:is(.is-on, .art-trigger:hover)) .in.s2 { transition-delay: 0.55s; }
  :global(:is(.is-on, .art-trigger:hover)) .in.s3 { transition-delay: 0.7s; }
  :global(:is(.is-on, .art-trigger:hover)) .ch.lt { transition-delay: 1.15s; }
  :global(:is(.is-on, .art-trigger:hover)) .hl { opacity: 1; }
  :global(:is(.is-on, .art-trigger:hover)) .b1 { transform: scaleX(1); }
  :global(:is(.is-on, .art-trigger:hover)) .b2 { transform: scaleX(0.62); transition-delay: 0.12s; }
  :global(:is(.is-on, .art-trigger:hover)) .b3 { transform: scaleX(0.38); transition-delay: 0.24s; }
  :global(:is(.is-on, .art-trigger:hover)) .f1 { transform: translate(4px, -3px); }
  :global(:is(.is-on, .art-trigger:hover)) .f2 { transform: translate(8px, -6px); }

  /* Loopar (bara medan förloppet är aktivt, och bara med rörelse påslagen). */
  @media (prefers-reduced-motion: no-preference) {
    :global(:is(.is-on, .art-trigger:hover)) .dot { animation: art-bounce 0.9s ease-in-out infinite; }
    :global(:is(.is-on, .art-trigger:hover)) .dot:nth-of-type(2) { animation-delay: 0.15s; }
    :global(:is(.is-on, .art-trigger:hover)) .dot:nth-of-type(3) { animation-delay: 0.3s; }
    :global(:is(.is-on, .art-trigger:hover)) .spin { animation: art-spin 2.4s linear infinite; }
  }
  @keyframes art-bounce {
    0%, 100% { transform: none; }
    40% { transform: translateY(-4px); }
  }
  @keyframes art-spin {
    to { transform: rotate(360deg); }
  }

  /* Reduced motion: slutläget direkt, utan övergångar. */
  @media (prefers-reduced-motion: reduce) {
    .m, .dr, .ds, .hl { transition: none; }
  }
</style>
