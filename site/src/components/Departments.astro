---
// Departments.astro – sektion "AI per avdelning" (Riktning D)
// Namngivna agenter i ett matt bento-rutnät. Klick morfar (FLIP) upp ett kort
// till en scrollbar lightbox med två flikar: "Så fungerar den" / "Exempel".
// Design från Claude Design; portad till Astro-konventioner (scoped style,
// vanilla JS, globala tokens i styles/global.css).
import Arrow from './Arrow.astro';

interface Example { txt: string; cite?: string }
interface Agent {
  id: string;
  num: string;
  name: string;
  lead: string;
  does: string;
  build: string;
  ex: Example | null;
}

const agents: Agent[] = [
  {
    id: 'kundtjanst',
    num: '01',
    name: 'Kundtjänst',
    lead: 'Svarar på återkommande frågor och slussar ärenden — dygnet runt, ur ert eget material.',
    does: 'Svarar på vanliga kundfrågor dygnet runt hämtat ur er egen kunskap, kvalificerar inkommande ärenden, slussar rätt sak till rätt person och sammanfattar långa trådar.',
    build: 'Vi kopplar en språkmodell till era egna källor (hjälpcenter, manualer, tidigare ärenden) med RAG, så svaren bygger på er data och kan källhänvisas. Den integreras mot mejl, chatt eller ärendesystem och eskalerar till människa när frågan ligger utanför ramen. Er data stannar hos er, EU-hosting.',
    ex: null,
  },
  {
    id: 'salj',
    num: '02',
    name: 'Sälj',
    lead: 'Prioriterar leads, sköter uppföljningen och skriver offertutkast.',
    does: 'Poängsätter inkommande leads efter köpstyrka, håller uppföljningen igång med automatiska sekvenser och tar fram offertutkast — så säljaren lägger tiden på att sälja, inte på administration.',
    build: 'Vi kopplar agenten mot ert CRM och era mejl, lägger in er leadscoring-logik och bygger uppföljningsflöden som triggas automatiskt. Offertutkast genereras från era mallar och prislistor, och säljaren godkänner innan något går ut.',
    ex: { txt: 'SEOS Design använde sälj-agenten för att avlasta monotona, återkommande uppgifter i säljflödet.', cite: 'SEOS Design · internt' },
  },
  {
    id: 'ekonomi',
    num: '03',
    name: 'Ekonomi',
    lead: 'Matchar fakturor och förbereder underlag inför bokslut.',
    does: 'Matchar fakturor mot ordrar och underlag, förbereder material inför bokslut och tar fram rapportutkast — det repetitiva i ekonomiflödet, gjort i tid.',
    build: 'Vi integrerar mot ert affärs-/bokföringssystem, sätter regler för matchning och avvikelser och låter agenten flagga det som inte stämmer. Inget bokförs utan att en människa godkänner.',
    ex: null,
  },
  {
    id: 'marknad',
    num: '04',
    name: 'Marknadsföring',
    lead: 'Bevakar marknaden och tar fram kampanj- och rubrikutkast.',
    does: 'Bevakar marknad och konkurrenter, hittar innehållsluckor och tar fram utkast till kampanjer och rubriker (A/B) — mer muskler på avdelningen utan att anställa fler.',
    build: 'Vi bygger agenten mot era källor och kanaler, definierar vad den ska bevaka och matar in er tonalitet så utkasten låter som ni. Ni sätter strategin och väljer vad som publiceras.',
    ex: null,
  },
  {
    id: 'kvalitetskontroll',
    num: '05',
    name: 'Kvalitetskontroll',
    lead: 'Förgranskar avtal, rapporter och innehåll före mänsklig slutgranskning.',
    does: 'Förgranskar omfattande material — avtal, rapporter, innehåll — och flaggar avvikelser, luckor och risker innan en människa gör slutgranskningen.',
    build: 'Vi definierar era kriterier och regelverk, kopplar agenten mot era dokumentkällor och bygger en granskningsprocess som lyfter fram det som behöver en mänsklig blick. Den ersätter inte slutgranskningen — den gör den snabbare.',
    ex: null,
  },
  {
    id: 'projektledning',
    num: '06',
    name: 'Projektledning',
    lead: 'Fångar inkommande mejl, skapar tasks och påminner vid deadline.',
    does: 'Bevakar en inkorg, skapar och tilldelar tasks i ert projektverktyg och påminner ansvarig när något närmar sig deadline — så inget faller mellan stolarna.',
    build: 'Vi kopplar agenten mot er mejl och ert projektverktyg (t.ex. Linear), sätter reglerna för hur ett mejl blir en task och vem som blir ansvarig, och låter systemet sköta påminnelserna.',
    ex: null,
  },
];
---

<section id="avdelningar" class="section aipa" aria-labelledby="aipa-heading">
  {/* Bakgrund: crossfade-loopad glas-video (Wannathis "Glass cylinders", dark;
      skarven var 7,16 → 0,85 efter crossfade). Ersatte /dep-bg.webp. Videon (z1)
      ligger över postern (z0 = fallback + reduced-motion) och under slöjan (z2)
      som mörkar/tonar ut mot kanterna så sektionen läser som raised yta, inte
      tapet. INGEN isolation/transform på .section — den innehåller lightboxen
      (position:fixed) som annars fångas under navbaren. */}
  <div class="dep-bg" aria-hidden="true"></div>
  {/* Ingen autoplay + preload="none": laddas inte ens ner förrän sektionen närmar
      sig vyn, och pausas när den lämnar den (inview-video.ts). Postern syns tills dess. */}
  <video
    class="dep-bg-video"
    data-inview-video
    preload="none"
    muted
    loop
    playsinline
    poster="/dep-glass-poster.webp"
    aria-hidden="true"
  >
    <source src="/dep-glass.webm" type="video/webm" />
    <source src="/dep-glass.mp4" type="video/mp4" />
  </video>
  <div class="dep-veil" aria-hidden="true"></div>
  <div class="container">
    <div class="sec-head reveal">
      <h2 id="aipa-heading" class="h2">Vad gör en AI-agent på just er avdelning?</h2>
      <p class="sec-head__lead">
        Vi bygger namngivna agenter mot en bestämd avdelning och process — inte en
        allmän chatt. Här är vad de gör, avdelning för avdelning.
      </p>
    </div>

    <div class="grid-wrap">
      <div class="grid-glow" aria-hidden="true"></div>
      <div class="agent-grid">
      {agents.map((a, i) => (
        <button
          class="agent-card reveal"
          type="button"
          data-index={i}
          aria-haspopup="dialog"
          aria-label={`${a.name} – se hur agenten fungerar`}
        >
          <span class="agent-card__num">{a.num}</span>
          <span class="agent-card__name">{a.name}</span>
          <span class="agent-card__lead">{a.lead}</span>
          <span class="agent-card__cue">
            Se hur den fungerar
            <Arrow class="agent-card__arrow" />
          </span>
        </button>
      ))}

      </div>
    </div>
  </div>

  <!-- Agentdata för lightboxen (egen, betrodd data — ej användargenererad) -->
  <script type="application/json" id="aipa-agents" set:html={JSON.stringify(agents)} is:inline></script>

  <!-- Lightbox: FLIP-morph-mål. Förrenderas dold; JS fyller i och animerar. -->
  <div class="lb" id="aipa-lb" hidden>
    <div class="lb__backdrop" data-close></div>
    <div class="lb__panel" role="dialog" aria-modal="true" aria-labelledby="aipa-lb-title">
      <div class="lb__surface" aria-hidden="true"></div>
      <div class="lb__content">
        <div class="lb__head">
          <div>
            <div class="lb__num"></div>
            <h3 class="lb__title" id="aipa-lb-title"></h3>
            <p class="lb__lead"></p>
          </div>
          <button class="lb__close" data-close type="button" aria-label="Stäng">×</button>
        </div>

        <div class="atabs">
          <div class="atabs__list" role="tablist" aria-label="Agentinformation">
            <button class="atabs__tab is-sel" role="tab" type="button" data-tab="0" aria-selected="true" tabindex="0">Så fungerar den</button>
            <button class="atabs__tab" role="tab" type="button" data-tab="1" aria-selected="false" tabindex="-1">Exempel</button>
          </div>
          <div class="atabs__panel" role="tabpanel" data-panel="0">
            <div class="agent-field">
              <span class="agent-field__k">Vad den gör</span>
              <p class="agent-field__v" data-does></p>
            </div>
            <div class="agent-field">
              <span class="agent-field__k">Så bygger vi den</span>
              <p class="agent-field__v" data-build></p>
            </div>
          </div>
          <div class="atabs__panel" role="tabpanel" data-panel="1" hidden>
            <div class="agent-ex" data-ex>
              <p class="agent-ex__txt" data-ex-txt></p>
              <div class="agent-ex__cite" data-ex-cite></div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  /* ---- layout ---- */
  .container {
    position: relative; /* + z-index → innehållet ovanför video/slöja (z0–2) */
    z-index: 3;
    max-width: var(--maxw-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
    width: 100%;
  }
  /* Raised-yta: lyfter denna kort-tunga sektion från void-sektionerna runtom.
     Bakgrunden är sedan sept 2026 en glas-VIDEO (se markupen) i stället för
     /dep-bg.webp (fotot kvar i public för ev. återbruk). Lagren: .dep-bg (poster,
     z0) · .dep-bg-video (z1) · .dep-veil (z2) · .container (z3).

     VIKTIGT: .section får INTE isolation/transform/filter/will-change — den
     innehåller lightboxen (position:fixed, z-index 100), och en containing block
     här hade fångat den under navbaren. position:relative är OK (fångar inte
     fixed). Slöjan mörkar/tonar videon mot kanterna så det läser som raised yta. */
  .section {
    position: relative;
    padding: var(--section-py) 0;
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }
  .dep-bg {
    position: absolute;
    inset: 0;
    z-index: 0;
    background: url("/dep-glass-poster.webp") center / cover no-repeat;
  }
  .dep-bg-video {
    position: absolute;
    inset: 0;
    z-index: 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .dep-veil {
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(120% 90% at 50% 50%, rgba(16, 16, 16, 0.55) 0%, rgba(16, 16, 16, 0.86) 72%),
      linear-gradient(180deg, var(--bg-raised) 0%, rgba(16, 16, 16, 0) 14%, rgba(16, 16, 16, 0) 86%, var(--bg-raised) 100%);
  }
  @media (prefers-reduced-motion: reduce) {
    .dep-bg-video { display: none; }
  }

  /* ---- reveal-on-scroll (innehåll alltid synligt; rörelse förstärker) ---- */
  .reveal {
    opacity: 1;
    transform: none;
  }
  @media (prefers-reduced-motion: no-preference) {
    .reveal.in {
      animation: fadeUp 0.7s var(--ease) backwards;
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: none;
    }
  }

  /* ---- sektionshuvud ---- */
  .eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: var(--fs-eyebrow);
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--fg-3);
    margin-bottom: 18px;
  }
  .eyebrow .num { color: var(--fg-2); }
  .eyebrow .sep { color: var(--border-strong); }

  .h2 {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    color: #fff;
  }

  .sec-head {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
  }
  .sec-head__lead {
    margin-top: 16px;
    color: var(--fg-3);
    font-size: var(--fs-lead);
    line-height: 1.6;
    max-width: 600px;
  }

  /* ============================================================
     Bento-rutnät — lika, luftiga kort (djupet bor i lightboxen)
     ============================================================ */
  .grid-wrap {
    position: relative;
    margin-top: 56px;
  }
  /* EN bred, mjuk ljuskälla bakom HELA rutnätet — glaset plockar upp den */
  .grid-glow {
    position: absolute;
    left: 50%;
    top: 46%;
    transform: translate(-50%, -50%);
    width: 82%;
    height: 78%;
    pointer-events: none;
    filter: blur(60px);
    z-index: 0;
    background: radial-gradient(
      55% 55% at 50% 45%,
      rgba(255, 255, 255, 0.09),
      hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 60% / 0.054) 45%,
      transparent 72%
    );
  }
  .agent-grid {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(268px, 1fr));
    gap: 18px;
  }

  .agent-card {
    position: relative;
    display: flex;
    flex-direction: column;
    text-align: left;
    min-height: 210px;
    isolation: isolate;
    border-radius: 22px;
    padding: 28px;
    cursor: pointer;
    /* Glas-look ("Tydligare") utan LIVE backdrop-filter: den kostade en om-
       suddning per scroll-frame × 6 kort (= scroll-lagg) för nästan noll vinst,
       eftersom bakgrunden bakom korten är statisk. Genomskinlig bas släpper in
       grid-glöden → samma glasiga känsla, men billigt och scroll-smooth. */
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.09), transparent 32%),
      linear-gradient(180deg, rgba(26, 29, 35, 0.72), rgba(14, 16, 21, 0.82));
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 12px 30px rgba(0, 0, 0, 0.42);
    /* Endast billiga (kompositor-vänliga) egenskaper animeras — INGEN transform
       eller box-shadow, som tvingar frostat glas att räkna om suddningen varje
       frame och gör hovern laggig. */
    transition: border-color 0.22s var(--ease);
  }
  /* azur-glöd som blommar BAKOM det hovrade kortet (viloläge lugnt → liv vid hover) */
  .agent-card::before {
    content: "";
    position: absolute;
    inset: -30px;
    z-index: -1;
    border-radius: 52px;
    pointer-events: none;
    opacity: 0;
    filter: blur(30px);
    transition: opacity 0.3s var(--ease);
    background: radial-gradient(
      50% 50% at 50% 50%,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 58% / 0.24),
      transparent 70%
    );
  }
  .agent-card::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: radial-gradient(120% 78% at 50% -12%, rgba(255, 255, 255, 0.07), rgba(255, 255, 255, 0) 62%);
    opacity: 0;
    transition: opacity 0.35s var(--ease);
  }
  .agent-card:not(.agent-card--soon):hover {
    border-color: hsl(var(--arc-hue) calc(var(--arc-sat) * 70%) 66% / 0.4);
  }
  .agent-card:not(.agent-card--soon):hover::after { opacity: 1; }
  /* azur-bloom bakom kortet vid hover/fokus */
  .agent-card:not(.agent-card--soon):hover::before,
  .agent-card:focus-visible::before { opacity: 1; }
  @media (prefers-reduced-motion: reduce) {
    .agent-card,
    .agent-card::before,
    .agent-card::after,
    .agent-card__arrow {
      transition: none;
    }
  }
  .agent-card:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }
  .agent-card__num {
    position: relative;
    z-index: 1;
    font-family: var(--font-mono);
    font-size: 13px;
    letter-spacing: 0.12em;
    color: var(--fg-2);
    margin-bottom: 22px;
  }
  .agent-card__name {
    position: relative;
    z-index: 1;
    font-size: var(--fs-h3);
    font-weight: 700;
    color: #fff;
    letter-spacing: -0.025em;
    line-height: 1.04;
    margin-bottom: 12px;
  }
  .agent-card__lead {
    position: relative;
    z-index: 1;
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-3);
  }
  .agent-card__cue {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 22px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-2);
  }
  .agent-card__arrow { transition: transform 0.25s var(--ease); }
  .agent-card:not(.agent-card--soon):hover .agent-card__arrow { transform: translate(3px, -3px); }

  /* "på väg": samma matta yta men plattare och dämpad */
  .agent-card--soon {
    cursor: default;
    background: linear-gradient(158deg, #131313 0%, #0f0f0f 60%, #0b0b0b 100%);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.03),
      0 10px 26px -18px rgba(0, 0, 0, 0.8);
  }
  .agent-card--soon .agent-card__name { color: var(--fg-2); }
  .agent-card__soon {
    position: relative;
    z-index: 1;
    margin-top: auto;
    padding-top: 22px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-4);
  }

  /* ============================================================
     Lightbox (FLIP-morph-mål)
     ============================================================ */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 100;
    display: none;
    place-items: center;
    padding: 26px;
  }
  .lb.is-open { display: grid; }
  /* INGEN backdrop-filter, medvetet: en blur över hela vyn (med Departments-
     videon spelande bakom) gav ett uppmätt 67ms-glapp (4 tappade rutor) i samma
     ögonblick som lightboxen öppnades — utan den: 0 tappade. 3px blur syntes
     ändå knappt bakom 72% mörker; lite mer mörker kompenserar. Tonas in i JS. */
  .lb__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(6, 6, 6, 0.78);
    cursor: pointer;
  }
  .lb__panel {
    position: relative;
    width: min(640px, 100%);
    max-height: 86vh;
    display: flex;
    flex-direction: column;
  }
  /* Ytan morfar från kortets ruta till panelens via top/left/width/height (se
     JS) — INTE via transform: scale(). En olikformig scale drog ut rundningen och
     1px-kanten under morfen. Ytan är ett tomt element i ett fixed lager, så
     layout per ruta kostar i princip inget (uppmätt 0 tappade rutor). */
  .lb__surface {
    position: absolute;
    inset: 0;
    z-index: 0;
    border-radius: 24px;
    background: linear-gradient(158deg, #191919 0%, #121212 52%, #0b0b0b 100%);
    border: 1px solid rgba(255, 255, 255, 0.07);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.06),
      0 44px 96px -30px rgba(0, 0, 0, 0.96),
      0 20px 50px -26px rgba(0, 0, 0, 0.85);
  }
  .lb__content {
    position: relative;
    z-index: 1;
    max-height: 86vh;
    overflow-y: auto;
    padding: 32px 32px 34px;
  }
  .lb__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 20px;
    margin-bottom: 26px;
  }
  .lb__num {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-3);
  }
  .lb__title {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: clamp(26px, 3vw, 34px);
    color: #fff;
    letter-spacing: -0.02em;
    margin: 11px 0;
  }
  .lb__lead {
    font-size: 15px;
    line-height: 1.55;
    color: var(--fg-3);
    max-width: 52ch;
  }
  .lb__close {
    flex-shrink: 0;
    width: 38px;
    height: 38px;
    display: grid;
    place-items: center;
    background: transparent;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--fg-2);
    font-size: 21px;
    line-height: 1;
    transition: border-color 0.2s var(--ease), color 0.2s var(--ease);
  }
  .lb__close:hover { border-color: var(--border-strong); color: #fff; }
  .lb__close:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* ============================================================
     Flikar — "Så fungerar den" / "Exempel"
     ============================================================ */
  .atabs__list {
    display: flex;
    flex-wrap: wrap;
    border-bottom: 1px solid var(--border);
    margin-bottom: 24px;
  }
  .atabs__tab {
    position: relative;
    background: transparent;
    border: 0;
    padding: 0 2px 13px;
    margin-right: 26px;
    white-space: nowrap;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-4);
    transition: color 0.2s var(--ease);
  }
  .atabs__tab:hover { color: var(--fg-2); }
  .atabs__tab.is-sel { color: #fff; }
  .atabs__tab:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-xs);
  }
  .atabs__tab::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -1px;
    height: 2px;
    background: var(--accent);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.25s var(--ease);
  }
  .atabs__tab.is-sel::after { transform: scaleX(1); }
  @media (prefers-reduced-motion: no-preference) {
    .atabs__panel:not([hidden]) { animation: fadeUp 0.3s var(--ease); }
  }

  .agent-field { margin-bottom: 20px; }
  .agent-field:last-child { margin-bottom: 0; }
  .agent-field__k {
    display: block;
    margin-bottom: 8px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-4);
  }
  .agent-field__v {
    font-size: 14.5px;
    line-height: 1.62;
    color: var(--fg-2);
    max-width: 64ch;
  }

  .agent-ex {
    border-left: 1px solid var(--border-strong);
    padding-left: 20px;
  }
  .agent-ex--neutral { border-left-color: var(--border); }
  .agent-ex__txt {
    font-size: 14.5px;
    line-height: 1.6;
    color: var(--fg-2);
    max-width: 60ch;
  }
  .agent-ex--neutral .agent-ex__txt { color: var(--fg-3); }
  .agent-ex__cite {
    margin-top: 11px;
    font-family: var(--font-mono);
    font-size: 10px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-4);
  }

  /* ---- reducerad rörelse + responsivt ---- */
  @media (prefers-reduced-motion: reduce) {
    .agent-card__arrow { transition: none; }
  }
  @media (max-width: 560px) {
    /* En ren enkolumn på små skärmar (undviker överflöd från grid-track-min) */
    .agent-grid { grid-template-columns: 1fr; margin-top: 40px; }
    .agent-card { min-height: 0; padding: 24px; }
  }
  @media (max-width: 520px) {
    .lb { padding: 14px; }
    .lb__content { padding: 24px; }
  }
</style>

<script>
  // AI per avdelning — FLIP-lightbox + flikar, tillgänglig vanilla-JS.
  // Kortet öppnar en dialog; kortets yta morfar (FLIP) upp till lightboxens yta.
  // Esc/backdrop stänger, fokus fångas i dialogen och återlämnas till kortet.
  (function () {
    const section = document.getElementById('avdelningar');
    if (!section) return;

    const dataEl = section.querySelector<HTMLScriptElement>('#aipa-agents');
    const lb = section.querySelector<HTMLElement>('#aipa-lb');
    const panel = lb?.querySelector<HTMLElement>('.lb__panel') ?? null;
    const surface = lb?.querySelector<HTMLElement>('.lb__surface') ?? null;
    const content = lb?.querySelector<HTMLElement>('.lb__content') ?? null;
    const backdrop = lb?.querySelector<HTMLElement>('.lb__backdrop') ?? null;
    if (!dataEl || !lb || !panel || !surface || !content || !backdrop) return;

    interface Example { txt: string; cite?: string }
    interface Agent { num: string; name: string; lead: string; does: string; build: string; ex: Example | null }

    let agents: Agent[] = [];
    try {
      agents = JSON.parse(dataEl.textContent || '[]');
    } catch {
      return;
    }

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    const elNum = lb.querySelector<HTMLElement>('.lb__num')!;
    const elTitle = lb.querySelector<HTMLElement>('.lb__title')!;
    const elLead = lb.querySelector<HTMLElement>('.lb__lead')!;
    const elDoes = lb.querySelector<HTMLElement>('[data-does]')!;
    const elBuild = lb.querySelector<HTMLElement>('[data-build]')!;
    const exWrap = lb.querySelector<HTMLElement>('[data-ex]')!;
    const exTxt = lb.querySelector<HTMLElement>('[data-ex-txt]')!;
    const exCite = lb.querySelector<HTMLElement>('[data-ex-cite]')!;
    const closeBtn = lb.querySelector<HTMLElement>('.lb__close')!;
    const tabs = Array.from(lb.querySelectorAll<HTMLElement>('.atabs__tab'));
    const panels = Array.from(lb.querySelectorAll<HTMLElement>('.atabs__panel'));

    let lastFocused: HTMLElement | null = null;

    const selectTab = (idx: number): void => {
      tabs.forEach((t, i) => {
        const sel = i === idx;
        t.classList.toggle('is-sel', sel);
        t.setAttribute('aria-selected', sel ? 'true' : 'false');
        t.setAttribute('tabindex', sel ? '0' : '-1');
      });
      panels.forEach((p, i) => { p.hidden = i !== idx; });
    };

    const populate = (a: Agent): void => {
      elNum.textContent = a.num;
      elTitle.textContent = a.name + '-agent';
      elLead.textContent = a.lead;
      elDoes.textContent = a.does;
      elBuild.textContent = a.build;
      if (a.ex) {
        exWrap.classList.remove('agent-ex--neutral');
        exTxt.textContent = a.ex.txt;
        exCite.textContent = a.ex.cite ?? '';
        exCite.style.display = a.ex.cite ? '' : 'none';
      } else {
        exWrap.classList.add('agent-ex--neutral');
        exTxt.textContent = 'Vi lägger in konkreta exempel här när de är styrkta.';
        exCite.textContent = '';
        exCite.style.display = 'none';
      }
      selectTab(0);
    };

    // ── Morfen (Web Animations API — ingen GSAP behövs) ─────────────────────
    // Tidigare: bara ytan skalades (transform: scale, olikformigt) medan
    // innehållet tonades in i sin SLUTstorlek → text, flikar och ×-knapp svävade
    // utanför den växande boxen (fångat i frysta rutor vid 80/160 ms), och
    // rundningen drogs ut. Nu: ytan animerar sin faktiska ruta (top/left/width/
    // height + radie) från kortet till panelen, och innehållet tonas in först
    // när boxen nästan är framme. Stängning = samma morf baklänges.
    const EASE =
      getComputedStyle(document.documentElement).getPropertyValue('--ease').trim() ||
      'cubic-bezier(.2,.7,.2,1)';
    const OPEN_MS = 420;
    const CLOSE_MS = 300;

    let anims: Animation[] = [];
    const stopAnims = (): void => {
      anims.forEach((an) => an.cancel());
      anims = [];
    };

    // Kortets ruta uttryckt relativt panelen (ytan är absolut positionerad i den).
    const boxes = (card: HTMLElement) => {
      const c = card.getBoundingClientRect();
      const p = panel.getBoundingClientRect();
      return {
        card: {
          top: `${c.top - p.top}px`,
          left: `${c.left - p.left}px`,
          width: `${c.width}px`,
          height: `${c.height}px`,
          borderRadius: getComputedStyle(card).borderRadius,
        },
        full: { top: '0px', left: '0px', width: `${p.width}px`, height: `${p.height}px`, borderRadius: '24px' },
      };
    };

    const open = (card: HTMLElement): void => {
      const idx = Number(card.getAttribute('data-index'));
      const a = agents[idx];
      if (!a) return;
      lastFocused = card;
      populate(a);
      lb.hidden = false;
      lb.classList.add('is-open');
      document.body.style.overflow = 'hidden';
      closeBtn.focus({ preventScroll: true });
      if (reduce) return;

      stopAnims();
      const b = boxes(card);
      anims = [
        backdrop.animate([{ opacity: 0 }, { opacity: 1 }], { duration: 300, easing: 'ease-out' }),
        surface.animate([b.card, b.full], { duration: OPEN_MS, easing: EASE }),
        // fill:'backwards' → osynligt under fördröjningen, så inget svävar ute.
        content.animate(
          [{ opacity: 0, transform: 'translateY(8px)' }, { opacity: 1, transform: 'none' }],
          { duration: 240, delay: OPEN_MS * 0.62, easing: 'ease-out', fill: 'backwards' },
        ),
      ];
    };

    let closing = false;
    const finishClose = (): void => {
      // Dölj FÖRST, avbryt animationerna SEN — annars återgår allt till CSS-
      // läget (full panel) en ruta innan lightboxen försvinner = blink.
      lb.classList.remove('is-open');
      lb.hidden = true;
      stopAnims();
      document.body.style.overflow = '';
      closing = false;
      if (lastFocused) {
        lastFocused.focus({ preventScroll: true });
        lastFocused = null;
      }
    };

    const close = (): void => {
      if (!lb.classList.contains('is-open') || closing) return;
      if (reduce || !lastFocused) {
        finishClose();
        return;
      }
      closing = true;
      stopAnims();
      const b = boxes(lastFocused);
      const shrink = surface.animate(
        [
          { ...b.full, opacity: 1 },
          { offset: 0.7, opacity: 1 },
          { ...b.card, opacity: 0 }, // tonar ut sista biten → kortet tar över
        ],
        { duration: CLOSE_MS, easing: EASE, fill: 'forwards' },
      );
      anims = [
        content.animate([{ opacity: 1 }, { opacity: 0 }], { duration: 120, easing: 'ease-in', fill: 'forwards' }),
        shrink,
        backdrop.animate([{ opacity: 1 }, { opacity: 0 }], { duration: CLOSE_MS, easing: 'ease-in', fill: 'forwards' }),
      ];
      shrink.finished.then(finishClose, () => {});
    };

    const onKey = (e: KeyboardEvent): void => {
      if (!lb.classList.contains('is-open')) return;
      if (e.key === 'Escape') {
        e.preventDefault();
        close();
        return;
      }
      if (e.key === 'Tab') {
        const focusables = Array.from(
          panel.querySelectorAll<HTMLElement>('button, [href], [tabindex]:not([tabindex="-1"])'),
        ).filter((el) => !el.hasAttribute('hidden') && el.offsetParent !== null);
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (e.shiftKey && document.activeElement === first) {
          e.preventDefault();
          last.focus();
        } else if (!e.shiftKey && document.activeElement === last) {
          e.preventDefault();
          first.focus();
        }
      }
    };

    const cards = Array.from(
      section.querySelectorAll<HTMLElement>('.agent-card:not(.agent-card--soon)'),
    );
    cards.forEach((card) => card.addEventListener('click', () => open(card)));

    lb.querySelectorAll<HTMLElement>('[data-close]').forEach((b) =>
      b.addEventListener('click', close),
    );

    tabs.forEach((t, i) => {
      t.addEventListener('click', () => selectTab(i));
      t.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        e.preventDefault();
        const next = e.key === 'ArrowRight' ? (i + 1) % tabs.length : (i - 1 + tabs.length) % tabs.length;
        selectTab(next);
        tabs[next].focus();
      });
    });

    document.addEventListener('keydown', onKey);

    // Reveal-on-scroll
    const io = new IntersectionObserver(
      (entries) => {
        entries.forEach((en) => {
          if (en.isIntersecting) {
            en.target.classList.add('in');
            io.unobserve(en.target);
          }
        });
      },
      { threshold: 0.15 },
    );
    section.querySelectorAll('.reveal').forEach((el) => io.observe(el));

    // Städa upp vid View Transitions-navigering
    document.addEventListener(
      'astro:before-swap',
      () => {
        document.removeEventListener('keydown', onKey);
        document.body.style.overflow = '';
        io.disconnect();
      },
      { once: true },
    );
  })();
</script>

<script>
  import '../scripts/inview-video';
</script>
