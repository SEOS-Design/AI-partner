---
// Nav.astro – flytande navbar i TRE FRISTÅENDE ZONER (fundamental.bg-referensen,
// Björn 2026-07-17): ordmärket sitter statiskt i vänsterkanten, glas-pillret i
// mitten innehåller BARA sidlänkarna, och boknings-CTA:n står till höger. Varken
// ordmärket eller CTA:n ligger i pillret.
//
// `.navbar` är flex space-between och håller BARA ordmärket + CTA:n. Den behöver
// inte centrera något: pillret är position:fixed och centrerar sig självt mot
// vyn (left:50% + translateX(-50%)). Den tidigare `1fr auto 1fr`-griden var till
// för att centrera pillret medan det låg i flödet — och gick sönder när det blev
// fixed: en out-of-flow-child deltar inte i grid-placeringen, så CTA:n
// auto-placerades i mittkolumnen och hamnade ovanpå pillret.
//
// Ytterramen `.navbar` behåller --maxw-content (1100px). Rör den inte: StackFlow
// är uppmätt mot nav:ens vänsterkant ("panelens glaskant = nav, exakt i linje").
//
// SCROLLBETEENDE (Björn 2026-07-17, uppmätt på referensen): BARA pillret är fixed.
// Ordmärket och CTA:n ligger i vanligt flöde och rullar bort med sidan — därför är
// `.nav` position:absolute, inte fixed, och pillret position:fixed inuti den.
// Mätt på fundamental.bg över scroll 0→2500: loggan y 60→-2440, CTA y 53→-2447,
// pillet y 42 hela vägen. Fungerar bara för att inget i Layout har transform/filter
// (som annars gör en fixed-descendant relativ till förfadern i stället för vyn).
//
// Pillret är tänt HELA tiden (inte längre en scroll-morf) → scroll-lyssnaren är
// borta, bara drawer-logiken är kvar i scriptet.
//
// Vertikal linjering: pillret och ordmärkes-/CTA-raden delar --nav-top och --nav-h,
// så båda centreras på samma axel. Utan det hamnar de 8px isär (pillret är
// naturligt 58px av radhöjden 1.7 på länkarna, CTA:n bara 42px).
//
// Aktivt-läge är route-baserat (highlightar länken vars href matchar sidans path).
import Arrow from './Arrow.astro';
//
// LÄNKARNA (Björns beslut 2026-07-17): fyra egna sidor. ALLA FYRA 404:ar tills de
// byggs — inklusive /kontakt, som tidigare var ankaret #kontakt och faktiskt
// fungerade (Contact-sektionen finns kvar på startsidan, id="kontakt", och nås
// fortfarande via "Boka"-CTA:erna → #boka). "Kunskapsbank" är BORTA: den bor på
// seosdesign.se enligt kannibaliseringskartan i docs/seo-soktermer.md — vi länkar
// dit, dubblerar inte. Slugarna är förslag; docs/seo-soktermer.md säger att
// sidstruktur ska spikas efter SERP-analys → bekräfta med Douglas/SEOS.
const links = [
  { href: '/tjanster', label: 'Tjänster' },
  { href: '/om-oss', label: 'Om oss' },
  { href: '/blogg', label: 'Blogg' },
  { href: '/kontakt', label: 'Kontakt' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => href.startsWith('/') && path === href;
---

<header id="main-nav" class="nav">
  <div class="navbar">
    <a class="wordmark" href="#top" aria-label="AI Partner — till toppen">AI PARTNER</a>

    <nav class="navpill nav-desktop" aria-label="Primär">
      {
        links.map((l) => (
          <a class:list={['nlink', { 'is-active': isActive(l.href) }]} href={l.href}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="nav__right">
      {/* Går till #boka (Contact-sektionen), inte till någon av de fyra
          404-sidorna — nav:en får en CTA som faktiskt fungerar i dag. */}
      <a class="btn btn-glass nav-cta nav-desktop" href="#boka">
        Boka kartläggning <Arrow class="arrow" />
      </a>
      <button
        class="nav-toggle"
        aria-label="Öppna meny"
        aria-expanded="false"
        aria-controls="drawer"
        data-menu-open
      >
        <span></span><span></span><span></span>
      </button>
    </div>
  </div>
</header>

<!-- Mobil-drawer -->
<div class="drawer-scrim" data-menu-close></div>
<aside class="drawer" id="drawer" aria-label="Meny" aria-hidden="true">
  <div class="drawer__hd">
    <a class="wordmark" href="#top" data-menu-close>AI Partner</a>
    <button class="drawer__close" aria-label="Stäng meny" data-menu-close>✕</button>
  </div>
  <nav class="drawer__links" aria-label="Meny">
    {
      links.map((l) => (
        <a class:list={[{ 'is-active': isActive(l.href) }]} href={l.href} data-menu-close>
          {l.label}
        </a>
      ))
    }
  </nav>
  {/* CTA:n döljs i nav-raden på mobil (ingen plats bredvid hamburgaren) → den
      bor här i stället, så bokningen finns kvar på små skärmar. */}
  <a class="btn btn-glass drawer__cta" href="#boka" data-menu-close>
    Boka kartläggning <Arrow class="arrow" />
  </a>
</aside>

<style>
  /* ══ Navbar ══
     Topp: helt transparent. Vid scroll: flytande frostad glas-pill. */
  .nav {
    --nav-top: 18px; /* top-marginal, delas av pillret + ordmärke + CTA */
    /* Radhöjd = pillets höjd. Pillret är fixed med top-kanten PÅ --nav-top (inte
       centrerad), medan ordmärke/CTA centreras i den här höjden. Sätts till
       CTA-höjden (~42px) så pillets top-kant linjerar med CTA:ns top-kant i
       stället för att sticka upp ovanför den (det gav pillret mindre top-marginal
       än sidorna → såg tight ut). */
    --nav-h: 42px;

    /* absolute, INTE fixed: ordmärket och CTA:n ska rulla bort med sidan.
       Bara .navpill nedan är fixed. */
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    z-index: 100;
    padding: var(--nav-top) 24px;
  }
  /* Ytterram: bara ordmärket + CTA:n, ytterst i var sin kant. Pillret ligger inte
     i den här flexen (det är fixed) utan centrerar sig självt mot vyn.
     Behåller --maxw-content (1100px) — StackFlow är uppmätt mot den här kanten. */
  .navbar {
    max-width: var(--maxw-content);
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    min-height: var(--nav-h);
  }
  .nav__right {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  /* Glas-pillret — BARA runt länkarna, det ENDA som är fixed, och tänt hela
     tiden. Höjden är explicit (inte padding-driven) så den matchar --nav-h
     exakt; annars styr länkarnas ärvda radhöjde 1.7 höjden och linjeringen mot
     ordmärkes-/CTA-raden spricker. */
  .navpill {
    position: fixed;
    top: var(--nav-top);
    left: 50%;
    transform: translateX(-50%);
    height: var(--nav-h);
    display: flex;
    align-items: center;
    gap: 32px;
    padding: 0 22px;
    border-radius: 999px;
    border: 1px solid var(--border-strong);
    background: linear-gradient(180deg, rgba(20, 22, 26, 0.66), rgba(12, 13, 17, 0.72));
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.07),
      0 14px 40px rgba(0, 0, 0, 0.5);
    -webkit-backdrop-filter: blur(16px) saturate(1.15);
    backdrop-filter: blur(16px) saturate(1.15);
  }

  /* Nav-CTA: kompaktare än sidans .btn (13px/28px → ~50px hög blir för tungt i
     en navrad). Scoped klass vinner över den globala .btn tack vare Astros
     attributselektor. */
  .nav-cta {
    padding: 9px 18px;
    font-size: 12px;
    border-radius: 999px;
  }

  /* wordmark — ren "AI Partner" i hero-H1:ans stil (Mona Sans 700, ingen prick) */
  .wordmark {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 20px;
    letter-spacing: -0.03em;
    color: var(--fg-1);
    white-space: nowrap;
  }

  .nlink {
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-3);
    padding: 6px 0;
    transition: color var(--dur-fast) var(--ease);
  }
  .nlink:hover,
  .nlink.is-active {
    color: var(--fg-1);
  }
  .nlink:focus-visible {
    outline: none;
    color: var(--fg-1);
    box-shadow: var(--focus-ring);
    border-radius: var(--radius-xs);
  }

  /* hamburger */
  .nav-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    justify-content: center;
    align-items: center;
    width: 42px;
    height: 42px;
    background: none;
    border: none;
    cursor: pointer;
    border-radius: var(--radius-xs);
  }
  .nav-toggle span {
    width: 20px;
    height: 1.5px;
    background: var(--fg-1);
    border-radius: 2px;
    transition:
      transform 0.28s var(--ease),
      opacity 0.2s var(--ease);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(1) {
    transform: translateY(6.5px) rotate(45deg);
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle[aria-expanded='true'] span:nth-child(3) {
    transform: translateY(-6.5px) rotate(-45deg);
  }
  .nav-toggle:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  /* ══ Mobil-drawer (glas) ══ */
  .drawer-scrim {
    position: fixed;
    inset: 0;
    z-index: 150;
    background: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 0.3s var(--ease),
      visibility 0.3s;
  }
  :global(body.menu-open) .drawer-scrim {
    opacity: 1;
    visibility: visible;
  }
  .drawer {
    position: fixed;
    top: 0;
    right: 0;
    bottom: 0;
    z-index: 160;
    width: min(84vw, 340px);
    transform: translateX(100%);
    transition: transform 0.38s var(--ease);
    background: linear-gradient(180deg, rgba(18, 20, 24, 0.96), rgba(10, 11, 14, 0.98));
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    backdrop-filter: blur(20px) saturate(1.2);
    border-left: 1px solid var(--border-strong);
    display: flex;
    flex-direction: column;
    padding: 22px 22px calc(22px + env(safe-area-inset-bottom));
  }
  :global(body.menu-open) .drawer {
    transform: translateX(0);
  }
  .drawer__hd {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 8px;
  }
  .drawer__links {
    display: flex;
    flex-direction: column;
    margin-top: 12px;
  }
  .drawer__links a {
    padding: 16px 4px;
    font-family: var(--font-sans);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--fg-3);
    border-bottom: 1px solid var(--border);
    transition: color var(--dur-fast) var(--ease);
  }
  .drawer__links a:hover,
  .drawer__links a.is-active {
    color: var(--fg-1);
  }
  .drawer__close {
    width: 40px;
    height: 40px;
    background: none;
    border: 1px solid var(--border);
    border-radius: var(--radius-xs);
    color: var(--fg-2);
    cursor: pointer;
    font-size: 18px;
    line-height: 1;
  }
  .drawer__close:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
  }

  .drawer__cta {
    margin-top: 24px;
    justify-content: center;
  }

  /* ── Tablet/mobil: dölj pillret OCH nav-CTA:n, visa hamburger ── */
  @media (max-width: 820px) {
    .nav-desktop {
      display: none;
    }
    .nav-toggle {
      display: flex;
    }
  }
</style>

<script>
  // Scroll-lyssnaren är BORTTAGEN 2026-07-17: pillret är tänt hela tiden och
  // morfar inte längre, så det fanns inget kvar för den att göra. Bara drawern.
  (function () {
    const body = document.body;
    const drawer = document.getElementById('drawer');
    if (!drawer) return;

    // Drawer öppna/stäng
    const setMenu = (open: boolean) => {
      body.classList.toggle('menu-open', open);
      drawer.setAttribute('aria-hidden', open ? 'false' : 'true');
      document.querySelectorAll<HTMLElement>('.nav-toggle').forEach((t) => {
        t.setAttribute('aria-expanded', open ? 'true' : 'false');
        t.setAttribute('aria-label', open ? 'Stäng meny' : 'Öppna meny');
      });
    };
    document
      .querySelectorAll<HTMLElement>('[data-menu-open]')
      .forEach((t) => t.addEventListener('click', () => setMenu(!body.classList.contains('menu-open'))));
    document
      .querySelectorAll<HTMLElement>('[data-menu-close]')
      .forEach((t) => t.addEventListener('click', () => setMenu(false)));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && body.classList.contains('menu-open')) setMenu(false);
    });
  })();
</script>
