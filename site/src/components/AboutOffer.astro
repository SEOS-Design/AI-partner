---
// AboutOffer.astro – "Från första samtal till AI i drift." på /om-oss (2026-09-28).
// Tre löften kopplade till de tre tjänstelagren i strategi-briefen:
// kartläggning (gratis ingång) → bygg (agenter per avdelning) → förvaltning.
//
// Rörelse: en accentlinje växer nedåt längs vänsterkanten i takt med scrollen. När
// linjen når en rad tänds dess nummer och text. Utan JS / reduced motion: linjen
// fylld, alla rader tända.
// (3D-ikonerna som tonades in till höger om aktiv rad — Wannathis Charts-stillbilder —
// togs bort 2026-10-08: kollegorna tyckte inte att 3D-illustrationerna passade in.)
// I stället (Björns val samma dag, "piffa upp typografiskt"): stora KONTURNUMMER
// 01–03 till höger, som på korten på /tjanster. Numret tänds när linjen når raden
// och får accentfärg + svag fyllnad på den aktiva raden; rubriken på rader som
// linjen inte nått är dämpad.
//
// Copy = utkast (Douglas granskar).

const ROWS = [
  {
    title: 'Vi kartlägger.',
    dim: 'Kostnadsfritt.',
    text: 'Vi går igenom era processer tillsammans med er och visar var AI lönar sig, och var den inte gör det. Ni får en prioriterad åtgärdsplan.',
  },
  {
    title: 'Vi bygger.',
    dim: 'Per avdelning.',
    text: 'Agenter för kundtjänst, sälj, ekonomi och kvalitetskontroll, och assistenter som svarar ur er egen data. Byggt mot en bestämd process, inte som allmän chatt.',
  },
  {
    title: 'Vi förvaltar.',
    dim: 'Efter lansering.',
    text: 'Rådgivning, AI-policy och löpande drift. Vi följer upp att lösningen fortsätter leverera och justerar när era processer ändras.',
  },
];
---

<section class="aoffer" aria-labelledby="aoffer-title">
  <div class="container">
    <h2 id="aoffer-title" class="aoffer__h">
      Från första samtal<br /><span class="aoffer__dim">till AI i drift.</span>
    </h2>

    <div class="aoffer__list">
      <span class="aoffer__track" aria-hidden="true"><span class="aoffer__fill"></span></span>
      <ol class="aoffer__rows">
      {ROWS.map((r, i) => (
        <li class="aoffer__row">
          <div class="aoffer__text">
            <h3 class="aoffer__title">
              {r.title} <span class="aoffer__dim">{r.dim}</span>
            </h3>
            <p>{r.text}</p>
          </div>
          <span class="aoffer__num" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span>
        </li>
      ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .aoffer {
    padding: var(--section-py) 0;
  }
  .container {
    max-width: var(--maxw-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .aoffer__h {
    margin: 0 0 clamp(40px, 5vw, 64px);
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: var(--lh-display);
    letter-spacing: var(--tracking-display);
    color: var(--fg-1);
  }
  .aoffer__dim {
    color: #666;
  }

  /* ---- listan med scroll-linjen ---- */
  .aoffer__list {
    --p: 1; /* 0–1, sätts av scriptet. Utan JS: full linje. */
    --indent: clamp(24px, 3.4vw, 48px); /* textens avstånd från scroll-linjen */
    position: relative;
  }
  .aoffer__rows {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .aoffer__track {
    position: absolute;
    left: 0;
    top: 0;
    bottom: 0;
    width: 1px;
    background: var(--border);
  }
  .aoffer__fill {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 90%) 78% / 0.2),
      hsl(var(--arc-hue) calc(var(--arc-sat) * 90%) 78%)
    );
    box-shadow: 0 0 10px hsl(var(--arc-hue) calc(var(--arc-sat) * 90%) 60% / 0.6);
    transform-origin: top;
    transform: scaleY(var(--p));
  }

  .aoffer__row {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: clamp(24px, 4vw, 64px);
    align-items: center;
    padding: clamp(28px, 3.5vw, 44px) 0 clamp(28px, 3.5vw, 44px) var(--indent);
    border-top: 1px solid var(--border);
    outline: none;
  }
  .aoffer__row:last-child {
    border-bottom: 1px solid var(--border);
  }

  /* Stort konturnummer till höger (samma grepp som korten på /tjanster). */
  .aoffer__num {
    font-stretch: 75%;
    font-weight: 800;
    font-size: clamp(88px, 12vw, 168px);
    line-height: 0.8;
    letter-spacing: 0.01em; /* siffrorna får inte överlappa: fyllnaden skulle täcka grannens kontur */
    /* Fyllnad = bakgrundsfärgen, ritad OVANPÅ konturen (paint-order). Typsnittets
       siffror består av överlappande delar, och en ren kontur (transparent fyllnad)
       visade de inre skarvarna som extra streck (ettans flagga, tvåans inre linjer).
       Fyllnaden täcker dem och konturens inre halva → 2px ger 1px skarp ytterlinje. */
    color: var(--bg);
    -webkit-text-stroke: 2px rgba(255, 255, 255, 0.12);
    paint-order: stroke fill;
    transition:
      -webkit-text-stroke-color 0.5s var(--ease),
      color 0.5s var(--ease);
    user-select: none;
  }

  .aoffer__title {
    margin: 0;
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--fs-h3);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-display);
    color: var(--fg-1);
    transition: color 0.4s var(--ease);
  }
  .aoffer__text p {
    margin: var(--space-3) 0 0;
    max-width: 38em;
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--fg-3);
    transition: color 0.4s var(--ease);
  }

  /* Med JS: rader som linjen inte nått är dämpade. */
  .aoffer__list.is-js .aoffer__row:not(.is-lit) .aoffer__title {
    color: var(--fg-3);
  }
  .aoffer__row.is-lit .aoffer__text p {
    color: var(--fg-2);
  }
  /* Tänd rad: konturen ljusnar. Aktiv rad (där linjen är nu): accent + svag fyllnad. */
  .aoffer__row.is-lit .aoffer__num {
    -webkit-text-stroke-color: rgba(255, 255, 255, 0.34);
  }
  .aoffer__row.is-active .aoffer__num {
    -webkit-text-stroke-color: hsl(var(--arc-hue) calc(var(--arc-sat) * 90%) 80%);
    color: color-mix(in srgb, hsl(var(--arc-hue) calc(var(--arc-sat) * 90%) 70%) 14%, var(--bg));
  }
  /* Utan JS: alla rader tända. */
  .aoffer__list:not(.is-js) .aoffer__num {
    -webkit-text-stroke-color: rgba(255, 255, 255, 0.34);
  }

  /* Smal skärm: numret litet ovanför rubriken i stället för till höger. */
  @media (max-width: 719px) {
    .aoffer__row {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-3);
    }
    .aoffer__num {
      order: -1;
      font-size: 56px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .aoffer__num,
    .aoffer__title,
    .aoffer__text p { transition: none; }
  }
</style>

<script>
  // Scroll-linjen: progress = hur långt listan har passerat en läslinje vid 60 % av
  // vyns höjd. Uppdateras i rAF bara när sektionen är nära vyn.
  const list = document.querySelector<HTMLElement>('.aoffer__list');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (list && !reduced && 'IntersectionObserver' in window) {
    list.classList.add('is-js');
    const rows = Array.from(list.querySelectorAll<HTMLElement>('.aoffer__row'));
    let raf = 0;
    let near = false;

    const update = () => {
      raf = 0;
      const r = list.getBoundingClientRect();
      const lineY = window.innerHeight * 0.6;
      const p = Math.min(1, Math.max(0, (lineY - r.top) / r.height));
      list.style.setProperty('--p', p.toFixed(4));

      let active = -1;
      rows.forEach((row, i) => {
        const top = row.offsetTop / r.height;
        const lit = p > top + 0.02;
        row.classList.toggle('is-lit', lit);
        if (lit) active = i;
      });
      // Sista raden släpper inte när linjen är full.
      rows.forEach((row, i) => row.classList.toggle('is-active', i === active));
    };
    const onScroll = () => {
      if (near && !raf) raf = requestAnimationFrame(update);
    };

    const io = new IntersectionObserver(
      (entries) => {
        near = entries.some((e) => e.isIntersecting);
        if (near) onScroll();
      },
      { rootMargin: '200px 0px' },
    );
    io.observe(list);
    list.style.setProperty('--p', '0');
    update();
    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll, { passive: true });
    document.addEventListener(
      'astro:before-swap',
      () => {
        io.disconnect();
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
      },
      { once: true },
    );
  }
</script>
