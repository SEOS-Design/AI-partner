---
// ServicesProcess.astro – "Hur går det till?" på /tjanster (2026-09-30): kartläggning,
// bygg, förvaltning i tre steg, direkt under heron.
// (Statementet "Vi börjar med er vardag. / Inte med en produktlista." som låg här
// ovanför togs bort, Björn: upprepade heron och stegen. Budskapet bor i herons ingress.)
// Copy = utkast (Douglas granskar).

const STEPS = [
  {
    n: '01',
    title: 'Kartläggning',
    text: 'Vi går igenom era processer tillsammans och hittar var tiden går. Kostnadsfritt, och ni bestämmer själva om ni går vidare.',
  },
  {
    n: '02',
    title: 'Bygg',
    text: 'Vi börjar med det som ger mest effekt och kopplar lösningen till systemen ni redan har.',
  },
  {
    n: '03',
    title: 'Förvaltning',
    text: 'Vi följer upp, justerar och sköter driften. Ni har samma kontakt hela vägen.',
  },
];
---

<section class="sproc" aria-labelledby="process-title">
  <div class="container">
    <h2 id="process-title" class="h2 process__h">Hur går det till?</h2>
    <ol class="process__list" role="list">
      {STEPS.map((s) => (
        <li class="step">
          <span class="step__n" aria-hidden="true">{s.n}</span>
          <h3 class="step__title">{s.title}</h3>
          <p class="step__text">{s.text}</p>
        </li>
      ))}
    </ol>
  </div>
</section>

<style>
  .sproc {
    padding: var(--section-py) 0;
  }
  .container {
    max-width: var(--maxw-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }
  .process__h { margin: 0; }
  .process__list {
    list-style: none;
    margin: clamp(40px, 5vw, 64px) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(24px, 4vw, 56px);
  }
  .step {
    border-top: 1px solid var(--border);
    padding-top: var(--space-5);
    position: relative;
  }
  /* Accentlinje på stegets hårstreck (som Stats-raderna). */
  .step::before {
    content: "";
    position: absolute;
    top: -1px;
    left: 0;
    width: 60%;
    height: 1px;
    background: linear-gradient(
      90deg,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 80% / 0.85),
      hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 76% / 0)
    );
  }
  .step__n {
    display: block;
    font-weight: 700;
    font-size: 22px;
    color: var(--fg-3);
    font-variant-numeric: tabular-nums;
  }
  .step__title {
    margin: var(--space-3) 0 var(--space-3);
    font-size: var(--fs-h3);
    font-weight: 700;
    line-height: var(--lh-heading);
    color: var(--fg-1);
  }
  .step__text {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--fg-2);
  }
  @media (max-width: 859px) {
    .process__list { grid-template-columns: minmax(0, 1fr); }
  }

</style>
