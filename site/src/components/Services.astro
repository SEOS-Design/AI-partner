---
// Services.astro – "tjänsterutorna" på startsidan (ersätter Departments i index
// sedan 2026-09-25; Departments.astro + lightboxen finns kvar, se index.astro).
//
// Referens: fundamental.bg/en "Our Services". 12-kolumnsgrid 5+7 / 4+3+5 med
// hårlinjer mellan rutorna. Vid hover/fokus tonas en animerad 3D-illustration in
// och spelar EN gång (stannar på sista rutan), ringen fylls och beskrivning + pil
// glider upp. Portad från motion-grid-bilder/animationer/prototyp.html.
//
// ILLUSTRATIONERNA (2026-10-08): linjeillustrationer i SVG (ServiceArt.astro) i
// stället för Wannathis 3D-videor, som kollegorna tyckte inte passade in. Motivet
// syns hela tiden (dämpat) och förloppet spelas när rutan är aktiv (.is-on: hover,
// fokus, eller "syns" på touch). PLATSHÅLLARE tills vidare (Björn).
// (Före det: videor som tonades in vid hover och spelade en gång — se git-historiken.)
//
// Länkarna går till respektive område på /tjanster (2026-09-30); byts mot
// /tjanster/<id> när ett område får en egen sida. OBS platshållare (Douglas):
// och copyn. Marknadsföring är medvetet utelämnad (finns inte i strategin).
import Arrow from './Arrow.astro';
import ServiceArt from './ServiceArt.astro';

const services = [
  {
    name: 'Kundtjänst',
    desc: 'Besvarar kundärenden direkt och lämnar över till er när det behövs.',
    href: '/tjanster#kundtjanst',
    id: 'kundtjanst' as const,
    span: 5,
  },
  {
    name: 'Ekonomi & administration',
    desc: 'Fakturor tolkas, konteras och går vidare till attest.',
    href: '/tjanster#ekonomi-administration',
    id: 'ekonomi-administration' as const,
    span: 7,
  },
  {
    name: 'Sälj & offert',
    desc: 'Leads poängsätts och offerten skrivs fram.',
    href: '/tjanster#salj-offert',
    id: 'salj-offert' as const,
    span: 4,
  },
  {
    name: 'Er egen AI-assistent',
    desc: 'Svarar med källa i era egna dokument.',
    href: '/tjanster#ai-assistent',
    id: 'ai-assistent' as const,
    span: 3,
  },
  {
    name: 'Kvalitet & projekt',
    desc: 'Avvikelser flaggas och veckorapporten skriver sig själv.',
    href: '/tjanster#kvalitet-projekt',
    id: 'kvalitet-projekt' as const,
    span: 5,
  },
];
---

<section id="tjanster" class="svc" aria-labelledby="svc-heading">
  <div class="container">
    <div class="sec-head">
      <h2 id="svc-heading" class="h2">Vad gör en AI-agent på just er avdelning?</h2>
      <p class="sec-head__lead">
        Vi bygger namngivna agenter mot en bestämd avdelning och process — inte en
        allmän chatt. Här är vad de gör, avdelning för avdelning.
      </p>
    </div>

    <ul class="svc-grid" role="list">
      {services.map((s) => (
        <li class="svc-item" style={`--span: ${s.span}`}>
          <a class="cell" href={s.href}>
            <span class="glow" aria-hidden="true"></span>
            <span class="media" aria-hidden="true">
              <ServiceArt id={s.id} />
            </span>
            <span class="ring" aria-hidden="true"></span>
            <span class="txt">
              <h3 class="name">
                {/* Ord med bindestreck bryts inte ("AI-/assistent"). */}
                {s.name.split(' ').map((w, i) => (
                  <>{i > 0 && ' '}{w.includes('-') ? <span class="nobr">{w}</span> : w}</>
                ))}
              </h3>
              <span class="desc">{s.desc}</span>
            </span>
            <Arrow class="arrow" />
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .svc {
    position: relative;
    padding: var(--section-py) 0;
  }
  .container {
    max-width: var(--maxw-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
    width: 100%;
  }

  /* ---- sektionshuvud (samma som Departments) ---- */
  .h2 {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-1);
  }
  .sec-head__lead {
    margin-top: var(--space-4);
    color: var(--fg-3);
    font-size: var(--fs-lead);
    line-height: 1.6;
    max-width: 600px;
  }

  /* ============================================================
     Grid — hårlinjerna ÄR gridets bakgrund som syns genom 1px-gapet
     ============================================================ */
  .svc-grid {
    --cell-bg: #050505;
    --cell-h: clamp(300px, 32vw, 380px);
    list-style: none;
    margin: 56px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: var(--cell-h);
    gap: 1px;
    background: var(--border-strong);
    border: 1px solid var(--border-strong);
    border-radius: 22px;
    overflow: hidden;
  }
  .svc-item {
    grid-column: span var(--span);
    min-width: 0;
    container-type: inline-size;
  }

  .cell {
    position: relative;
    display: block;
    height: 100%;
    overflow: hidden;
    isolation: isolate;
    background: var(--cell-bg);
    color: inherit;
    text-decoration: none;
  }
  /* Fokusringen inåt — gridets overflow:hidden klipper allt som ligger utanför. */
  .cell:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: -6px;
  }

  .ring {
    position: absolute;
    top: var(--space-5);
    left: var(--space-5);
    width: 16px;
    height: 16px;
    border-radius: 50%;
    border: 1.5px solid var(--fg-1);
    transition: background-color 0.4s var(--ease);
  }

  .glow {
    position: absolute;
    inset: 0;
    opacity: 0;
    pointer-events: none;
    transition: opacity var(--dur-mid) var(--ease);
    background: radial-gradient(
      60% 55% at 50% 42%,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 70%) 45% / 0.26),
      transparent 70%
    );
  }

  /* Illustrationen: syns hela tiden, dämpad i vila och full styrka när rutan är
     aktiv. Ytan ligger ovanför texten; SVG:n skalar in i den (behåller proportionen). */
  .media {
    position: absolute;
    top: var(--space-6);
    left: var(--space-5);
    right: var(--space-5);
    bottom: 96px;
    opacity: 0.6;
    transition: opacity 0.5s var(--ease);
    pointer-events: none;
  }
  /* Smala rutor (3-kolumnsrutan): rubriken går på två rader och beskrivningen
     på två–tre → ge texten mer plats så den inte hamnar över motivet. */
  @container (max-width: 320px) {
    .media { bottom: 150px; }
  }

  .txt {
    position: absolute;
    left: var(--space-5);
    right: calc(var(--space-5) + 32px); /* plats för pilen */
    bottom: var(--space-5);
  }
  .name {
    font-family: var(--font-sans);
    font-weight: 700;
    /* Egen storlek, inte --fs-h3 (48 px): "AI-assistent" måste rymmas i den
       smala 3-kolumnsrutan (~250 px). */
    font-size: clamp(24px, 2.6vw, 36px);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-tight);
    color: var(--fg-3);
    transition: color 0.4s var(--ease);
  }
  .nobr {
    white-space: nowrap;
  }
  .desc {
    display: block;
    font-size: var(--fs-body);
    line-height: 1.5;
    color: var(--fg-3);
    max-height: 0;
    opacity: 0;
    overflow: hidden;
    transition:
      opacity 0.45s var(--ease),
      max-height var(--dur-mid) var(--ease),
      margin-top var(--dur-mid) var(--ease);
  }
  .cell :global(.arrow) {
    position: absolute;
    right: var(--space-5);
    bottom: calc(var(--space-5) + 4px);
    width: 22px;
    height: 22px;
    color: var(--fg-1);
    opacity: 0;
    transform: translate(-6px, 6px);
    transition:
      opacity 0.4s var(--ease),
      transform 0.5s var(--ease);
  }

  /* ---- aktivt läge: .is-on (JS: hover, fokus, eller "syns" på touch) ----
     :focus-visible och :hover som fallback utan JS (texten; illustrationens förlopp
     kräver .is-on). */
  .cell.is-on .media { opacity: 1; }
  .cell:is(.is-on, :focus-visible) .glow { opacity: 1; }
  .cell:is(.is-on, :focus-visible) .ring { background-color: var(--fg-1); }
  .cell:is(.is-on, :focus-visible) .name { color: var(--fg-1); }
  .cell:is(.is-on, :focus-visible) .desc {
    opacity: 1;
    max-height: 4.5em; /* upp till tre rader i smala rutor */
    margin-top: var(--space-2);
  }
  .cell:is(.is-on, :focus-visible) :global(.arrow) { opacity: 1; transform: none; }
  @media (hover: hover) {
    .cell:hover .glow { opacity: 1; }
    .cell:hover .ring { background-color: var(--fg-1); }
    .cell:hover .name { color: var(--fg-1); }
    .cell:hover .desc { opacity: 1; max-height: 4.5em; margin-top: var(--space-2); }
    .cell:hover :global(.arrow) { opacity: 1; transform: none; }
  }

  /* ---- responsivt ---- */
  /* Surfplatta: två kolumner, sista rutan full bredd. */
  @media (max-width: 959px) {
    .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .svc-item { grid-column: span 1; }
    .svc-item:last-child { grid-column: span 2; }
  }
  /* Mobil: en kolumn. Rutorna aktiveras när de syns (scriptet) i stället för hover. */
  @media (max-width: 639px) {
    .svc-grid {
      grid-template-columns: minmax(0, 1fr);
      --cell-h: clamp(300px, 88vw, 360px);
    }
    .svc-item,
    .svc-item:last-child { grid-column: auto; }
  }

  /* ---- reduced motion: inga övergångar (illustrationen visar slutläget direkt) ---- */
  @media (prefers-reduced-motion: reduce) {
    .media,
    .glow,
    .ring,
    .name,
    .desc,
    .cell :global(.arrow) { transition: none; }
  }
</style>

<script>
  // Hover/fokus sätter .is-on på rutan → texten kommer fram och illustrationens
  // förlopp spelas (CSS i ServiceArt.astro). När rutan lämnas går allt tillbaka.
  //
  // Touch (ingen hover): rutan aktiveras när den syns ordentligt och ligger kvar
  // aktiv — förloppet spelar en gång och beskrivningen är framme.
  const section = document.querySelector<HTMLElement>('.svc');

  if (section) {
    const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
    const cells = Array.from(section.querySelectorAll<HTMLAnchorElement>('.cell'));

    const activate = (cell: HTMLElement) => cell.classList.add('is-on');
    const deactivate = (cell: HTMLElement) => {
      // Fokus kvar i rutan (t.ex. musen lämnar en tabbad ruta) → behåll läget.
      if (cell.matches(':focus-visible')) return;
      cell.classList.remove('is-on');
    };

    let showObserver: IntersectionObserver | undefined;

    if (canHover) {
      cells.forEach((cell) => {
        cell.addEventListener('pointerenter', () => activate(cell));
        cell.addEventListener('pointerleave', () => deactivate(cell));
      });
    } else {
      showObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (!e.isIntersecting) return;
            activate(e.target as HTMLElement);
            showObserver?.unobserve(e.target);
          });
        },
        { threshold: 0.6 },
      );
      cells.forEach((c) => showObserver!.observe(c));
    }

    // Tangentbord = hover.
    cells.forEach((cell) => {
      cell.addEventListener('focusin', () => activate(cell));
      cell.addEventListener('focusout', () => {
        if (canHover && cell.matches(':hover')) return;
        if (!canHover) return; // touch: läget ligger kvar
        deactivate(cell);
      });
    });

    document.addEventListener('astro:before-swap', () => showObserver?.disconnect(), { once: true });
  }
</script>
