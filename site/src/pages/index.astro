---
import Hero from '../components/Hero.astro';
import Positionering from '../components/Positionering.astro';
import Stats from '../components/Stats.astro';
// Tjänsterutorna (Services) ersätter Departments sedan 2026-09-25. Departments.astro
// (agentkort + lightbox) finns kvar: återställ genom att avkommentera importen och
// byta <Services /> mot <Departments /> nedan.
// import Departments from '../components/Departments.astro';
import Services from '../components/Services.astro';
// StartFlow-VARIANTER: StartProcess = Consolidator-stil, fastlåst med scrollstyrd glaskub
// (2026-09-25, aktiv). StartFlowRail = rak rad. Vågen = StartFlow.astro. Gamla diagonala
// kaskaden = StartFlow.cascade.astro.bak (döp om till .astro för att visa).
// import StartFlow from '../components/StartFlow.astro';
// import StartFlow from '../components/StartFlowRail.astro';
import StartFlow from '../components/StartProcess.astro';
import Advisory from '../components/Advisory.astro';
import Team from '../components/Team.astro';
import StackFlow from '../components/StackFlow.astro';
// FAQ parkerad: flyttas till /om-oss när den sidan byggs (komponenten är kvar).
import Contact from '../components/Contact.astro';
// import ArcBand from '../components/ArcBand.astro'; // pausad, se nedan
import Footer from '../components/Footer.astro';
import Layout from '../layouts/Layout.astro';
---

<Layout>
  <Hero />
  <Positionering />
  <Stats />
  {/* Tjänsterutorna är en katalog (5 rutor man skannar samtidigt) → egen obunden
      sektion, INTE i stacken. Bygg-läget i flödet: Ingång → Bygg → avslutande
      stack-berättelse. (Tidigare: <Departments />, se importen.) */}
  <Services />
  <StartFlow />
  {/* Kortstack: tre stack-vänliga en-budskaps-paneler (förvaltning → vilka vi är
      → boka). Revertera genom att ta bort <StackFlow> och lägga tillbaka de tre
      som vanliga syskon. FAQ är parkerad (flyttas till /om-oss). */}
  <StackFlow>
    <Advisory slot="one" />
    <Team slot="two" />
    <Contact slot="three" />
  </StackFlow>
  {/* ArcBand (azurlinjen ovanför footern) BORTTAGEN 2026-09-24 — Björn: för mycket mot
      sektionen ovanför. Ersatt av footerns hårlinje + sken. Filen finns kvar. */}
  <Footer />
</Layout>
