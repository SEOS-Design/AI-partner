  kundtjanst: '54 18 136 184',
  'salj-offert': '20 14 134 180',
  'ai-assistent': '28 10 150 206',
  'intern-admin': '18 12 96 148',
  marknad: '96 14 130 176',
};
const viewBox = compact ? CROP[id] : '0 0 320 220';
