---
// Footer.astro – variant A (Björns val 2026-09-24, SeaPattern-referensen):
// märke + kort rad till vänster, två länkkolumner till höger, och det stora
// ordmärket som STIGER UR bottenradens hårlinje.
//
// ORDMÄRKET (mekaniken uppmätt på seapattern.com/sv): ligger i en wrapper med
// overflow:hidden och negativ nedermarginal → nedre biten klipps alltid av vid
// bottenradens linje, så det "sticker upp". När footern syns glider det upp från
// translateY(80%) + opacity 0 på 1,5 s (opacity 1,1 s) med --ease. Engångs, inte
// scroll-scrubbat. Synligt som bas (repo-konvention): JS "armar" det först, så
// utan JS eller vid reduced-motion står det bara stilla i slutläget.
//
// LÄNKAR: "Blogg" → Kunskapsbank (/kunskapsbank/ krävs av innehållsöverlämningen,
// se docs/innehall-utan-cms.md). Alla undersidor 404 tills de byggs.
// "Mer": SEOS Design + cookie-platshållare (Björn 2026-09-24). Bottenraden:
// "Sida av SEOS Design" (ersatte Integritetspolicy — en sådan sida behövs ändå
// före lansering, kontaktformuläret samlar personuppgifter). Ingen LinkedIn:
// AI Partner har ingen egen sida (bara SEOS).
// Ovanför footern låg tidigare ArcBand (färgad linje) — ersatt av neutral
// topplinje + sken (Conversion-referensen).

const pages: [string, string][] = [
  ['Tjänster', '/tjanster'],
  ['Om oss', '/om-oss'],
  ['Kunskapsbank', '/kunskapsbank'],
  ['Kontakt', '/kontakt'],
];
---

<footer class="foot">
  {/* "Soluppgång" på footerns topplinje (Conversion-referensen): ett runt klot bakom
      sidan, ljust ovanför linjen, dämpat under den. Sex förskjutna, kraftigt suddade
      färgmoln i heroens palett (se CSS). */}
  <div class="foot__orb" aria-hidden="true">
    <span class="orb orb--haze"></span>
    <span class="orb orb--deep"></span>
    <span class="orb orb--violet"></span>
    <span class="orb orb--steel"></span>
    <span class="orb orb--lilac"></span>
    <span class="orb orb--core"></span>
  </div>

  <div class="container foot__top">
    <div class="foot__brand">
      <span class="foot__mark">AI PARTNER</span>
      <p class="foot__lead">AI-agenter och automation för svenska företag.</p>
    </div>

    <nav class="foot__col" aria-label="Sidan">
      <span class="foot__hd">Sidan</span>
      {pages.map(([label, href]) => <a href={href}>{label}</a>)}
    </nav>

    <nav class="foot__col" aria-label="Mer">
      <span class="foot__hd">Mer</span>
      <a href="https://seosdesign.se" target="_blank" rel="noopener noreferrer">SEOS Design <span aria-hidden="true">↗</span></a>
      {/* PLATSHÅLLARE tills cookie-lösningen finns: knappen ska öppna
          samtyckesbannerns inställningar, /cookiepolicy är en framtida sida (404). */}
      <button type="button" class="foot__linkbtn" data-cookie-settings>Cookieinställningar</button>
      <a href="/cookiepolicy">Cookiepolicy</a>
    </nav>
  </div>

  <div class="foot__wm-wrap" aria-hidden="true">
    <div class="foot__wm" data-foot-wm>AI PARTNER</div>
  </div>

  <div class="foot__bottom">
    <div class="container foot__bottom-in">
      <span>© 2026 AI Partner</span>
      <a href="https://seosdesign.se" target="_blank" rel="noopener noreferrer">Sida av SEOS Design</a>
    </div>
  </div>
</footer>

<style>
  /* overflow-x: clip (inte hidden) → klotet får sticka upp OVANFÖR footern men
     klipps i sidled. Ordmärket har sin egen overflow-wrapper.
     Footern skapar INGEN staplingskontext (ingen isolation/z-index) — annars
     hamnar klotets z-index:-1 inuti footern i stället för bakom sidan. */
  .foot {
    position: relative;
    overflow-x: clip;
    /* HALVGENOMSKINLIG: dämpar klotets nedre halva → horisontsteget vid linjen
       (ljust ovanför, dovt under — som hos Conversion). Opak hade dolt det helt. */
    background: rgba(10, 10, 10, 0.62);
    border-top: 1px solid var(--border);
  }

  /* ── Klotet v2 (2026-09-29) ──
     Björn: klotet lutade åt ett håll (blått). Nu "spretigt" och grumligt som hos
     conversion.framer.media (orange/krämvitt/mörkrött/petrol i samma sken), men i
     HEROENS palett. Uppmätt ur hero-glass.mp4 (Playwright/pngjs, 10 rutor):
     indigo 230–249° = 67 % av färgen, violett 250–279° = 25 %, stålblått 210–229° = 7 %;
     mättnad 42–67 %. Sex runda moln, förskjutna från mitten och kraftigt suddade så
     de flyter ihop; en gråaktig indigodimma i botten ger det grumliga, en blek
     lavendelvit topp motsvarar Conversions krämvita kärna.
     Färgerna är LÅSTA här (oberoende av --arc-hue), som förut.
     z-index:-1 i rotens staplingskontext → bakom kortet/sektionen ovanför men
     ovanför sidans canvas. Ett statiskt klot kostar inget per bildruta. */
  .foot__orb {
    position: absolute;
    top: 0;
    left: 50%;
    z-index: -1;
    width: 0;
    height: 0;
    pointer-events: none;
  }
  .orb {
    position: absolute;
    border-radius: 50%;
    /* --x/--y = förskjutning från klotets mitt */
    transform: translate(calc(-50% + var(--x, 0px)), calc(-50% + var(--y, 0px)));
  }
  /* Grumlig bas: bred, lågmättad indigodimma. */
  .orb--haze {
    width: 520px;
    height: 520px;
    filter: blur(56px);
    opacity: 0.9;
    background: radial-gradient(circle, hsl(244 28% 34%) 0%, hsl(244 24% 22%) 55%, transparent 72%);
  }
  /* Djup indigo nedtill — heroens huvudton. */
  .orb--deep {
    --y: 50px;
    width: 360px;
    height: 360px;
    filter: blur(44px);
    opacity: 0.9;
    background: radial-gradient(circle, hsl(240 62% 44%) 0%, hsl(242 55% 32%) 60%, transparent 75%);
  }
  /* Violett åt vänster. */
  .orb--violet {
    --x: -95px;
    --y: -10px;
    width: 280px;
    height: 280px;
    filter: blur(46px);
    opacity: 0.85;
    background: radial-gradient(circle, hsl(266 52% 56%) 0%, hsl(266 45% 40%) 55%, transparent 75%);
  }
  /* Stålblått åt höger. */
  .orb--steel {
    --x: 100px;
    --y: 5px;
    width: 260px;
    height: 260px;
    filter: blur(46px);
    opacity: 0.8;
    background: radial-gradient(circle, hsl(212 48% 56%) 0%, hsl(215 42% 40%) 55%, transparent 75%);
  }
  /* Liten ljuslila fläck snett upptill. */
  .orb--lilac {
    --x: 45px;
    --y: -75px;
    width: 170px;
    height: 170px;
    filter: blur(38px);
    opacity: 0.75;
    background: radial-gradient(circle, hsl(282 45% 68%) 0%, transparent 72%);
  }
  /* Blek lavendelvit kärna, lite till vänster om mitten. */
  .orb--core {
    --x: -15px;
    --y: -40px;
    width: 210px;
    height: 210px;
    filter: blur(30px);
    opacity: 0.8;
    background: radial-gradient(circle, hsl(248 38% 88%) 0%, hsl(248 32% 70%) 40%, transparent 72%);
  }
  @media (max-width: 560px) {
    .foot__orb { transform: scale(0.66); }
  }

  .foot__top {
    position: relative;
    display: grid;
    grid-template-columns: 1.6fr 1fr 1fr;
    gap: var(--space-7);
    padding-top: var(--space-8);
    padding-bottom: var(--space-7);
  }
  .foot__mark {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: 24px;
    letter-spacing: -0.03em;
    color: var(--fg-1);
  }
  .foot__lead {
    margin-top: var(--space-4);
    max-width: 32ch;
    font-size: var(--fs-body);
    line-height: 1.55;
    color: var(--fg-3);
  }

  .foot__col {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .foot__hd {
    font-stretch: 75%; /* versal etikett: smal bredd */
    margin-bottom: var(--space-2);
    font-size: var(--fs-eyebrow);
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    text-transform: uppercase;
    color: var(--fg-4);
  }
  .foot__col a,
  .foot__linkbtn {
    width: fit-content;
    font-size: var(--fs-body);
    line-height: var(--lh-body);
    color: var(--fg-3);
    transition: color var(--dur-fast) var(--ease);
  }
  .foot__linkbtn {
    padding: 0;
    border: 0;
    background: none;
    text-align: left;
  }
  .foot__col a:hover,
  .foot__linkbtn:hover {
    color: var(--fg-1);
  }

  /* ── Ordmärket ── */
  .foot__wm-wrap {
    position: relative;
    overflow: hidden;
    pointer-events: none;
  }
  .foot__wm {
    font-family: var(--font-sans);
    font-weight: 700;
    font-size: clamp(76px, 17vw, 250px);
    line-height: 0.9;
    letter-spacing: -0.045em;
    white-space: nowrap;
    text-align: center;
    user-select: none;
    /* nedre biten klipps av wrapperns overflow → "sticker upp" ur bottenlinjen */
    margin-bottom: -0.13em;
    background: linear-gradient(180deg, rgba(255, 255, 255, 0.15) 0%, rgba(255, 255, 255, 0.015) 88%);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }
  @media (prefers-reduced-motion: no-preference) {
    .foot__wm {
      transition:
        transform 1.5s var(--ease),
        opacity 1.1s var(--ease);
    }
    /* armat av JS (utanför vy) → glider upp när .is-in läggs på */
    .foot__wm.is-armed:not(.is-in) {
      transform: translateY(80%);
      opacity: 0;
    }
  }

  .foot__bottom {
    position: relative;
    border-top: 1px solid var(--border);
  }
  .foot__bottom-in {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    padding-top: 22px;
    padding-bottom: var(--space-5);
    font-size: 13px;
    letter-spacing: 0.04em;
    color: var(--fg-4);
  }
  .foot__bottom-in a {
    color: var(--fg-3);
    transition: color var(--dur-fast) var(--ease);
  }
  .foot__bottom-in a:hover {
    color: var(--fg-1);
  }

  @media (max-width: 900px) {
    .foot__top {
      grid-template-columns: 1fr 1fr;
      gap: var(--space-6);
    }
    .foot__brand {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .foot__top {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  // Ordmärket glider upp ur bottenlinjen när footern syns (engångs).
  (function () {
    const wm = document.querySelector<HTMLElement>('[data-foot-wm]');
    if (!wm || !('IntersectionObserver' in window)) return;
    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    wm.classList.add('is-armed');
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          wm.classList.add('is-in');
          io.disconnect();
        }
      },
      // wrappern observeras (ordmärket självt ligger nedflyttat/klippt när det är armat)
      { threshold: 0.15 },
    );
    io.observe(wm.parentElement as Element);
    document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
  })();
</script>
