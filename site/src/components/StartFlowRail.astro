---
// StartFlowRail.astro – "Var börjar ni med AI?" som RAK RAD (test 2026-09-24).
// Björn tyckte vågen (StartFlow.astro) var svår att läsa av. Den här varianten tar
// den GAMLA designens språk (StartFlow.cascade.astro.bak: ogenomskinliga kort +
// ljusslinga med vandrande puls) men lägger de tre stegen på EN rad, lika höga och
// med samma struktur (nummer · rubrik · text) → läses vänster till höger utan
// att man behöver leta. Texterna är vågens (rubrik per steg, lättare att skumma).
//
// SKENAN: löper längs kortens överkant med en port mitt på varje kort. En ljuspuls
// vandrar 1 → 2 → 3 och porten tänds när pulsen passerar (samma cykel, förskjutna
// delays). Bara transform/opacity animeras. Reduced motion → statisk skena.
// Mobil (≤820px): lodrät stapel, skenan längs vänsterkanten.
//
// ALLA TRE VARIANTERNA FINNS KVAR: StartFlow.astro (vågen), denna, och
// StartFlow.cascade.astro.bak (gamla diagonala kaskaden). Växla i index.astro.
import Arrow from './Arrow.astro';

const BOOK = '#boka';

const STEPS = [
  { n: '01', h: 'Kartläggning på plats', t: 'Vi går igenom era processer på plats. Vad tar tid i dag, och vad återkommer varje vecka?' },
  { n: '02', h: 'Prioritering', t: 'Var ger AI och automation störst effekt, och var gör den det inte? Vi är ärliga med båda.' },
  { n: '03', h: 'Åtgärdsplan', t: 'Konkret och prioriterad. Inget köptvång, ni bestämmer själva om ni går vidare.' },
];
---

<section id="sa-borjar-ni" class="rflow" aria-labelledby="rflow-title">
  <div class="container">
    <div class="rflow__head">
      <h2 id="rflow-title">Var börjar ni med AI?</h2>
      <p class="rflow__lead">Med en kostnadsfri kartläggning.</p>
    </div>

    <div class="rflow__stage">
      <div class="rail" aria-hidden="true">
        <span class="rail__line"></span>
        <span class="rail__run"><span class="rail__pulse"></span></span>
        <span class="rail__port rail__port--1"></span>
        <span class="rail__port rail__port--2"></span>
        <span class="rail__port rail__port--3"></span>
      </div>

      <ol class="rflow__steps">
        {STEPS.map((s) => (
          <li class="rstep">
            <span class="rstep__n">{s.n}</span>
            <h3 class="rstep__h">{s.h}</h3>
            <p class="rstep__t">{s.t}</p>
          </li>
        ))}
      </ol>
    </div>

    <div class="rflow__close">
      <p>
        Kartläggningen är kostnadsfri och utan köptvång. Vi kommer ut och går igenom era
        processer, eller föreläser för teamet om ni vill förstå AI först.
      </p>
      <a class="btn btn-primary" href={BOOK}>Boka en tid <Arrow class="arrow" /></a>
    </div>
  </div>
</section>

<style>
  .rflow {
    position: relative;
    padding: var(--section-py) 0;
    /* .rail__run (skenans bredd) förskjuts +100 % → sticker ut långt till höger i
       slutet av varvet. Utan klipp räknas det som scrollbart innehåll: en horisontell
       scrollbar som kom och gick varje varv (sidan "hackade"). clip, inte hidden,
       så sektionen inte blir en scrollbehållare. */
    overflow-x: clip;
    /* geometri: kolumngap + skenans höjd över korten */
    --gap: clamp(16px, 2vw, 28px);
    --rail-y: 0px; /* skenan ligger PÅ kortens överkant */
    --dur: 4.2s;
  }

  .rflow__head {
    max-width: 720px;
    margin-inline: auto;
    text-align: center;
  }
  .rflow__head h2 {
    font-weight: 600;
    font-size: var(--fs-h2);
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-display);
    color: var(--fg-1);
    text-wrap: balance;
  }
  .rflow__lead {
    margin-top: var(--space-4);
    font-size: var(--fs-lead);
    color: var(--fg-3);
  }

  .rflow__stage {
    position: relative;
    margin-top: clamp(48px, 6vw, 80px);
  }

  /* ── Stegen: tre lika höga kort på en rad ── */
  .rflow__steps {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--gap);
  }
  .rstep {
    position: relative;
    display: flex;
    flex-direction: column;
    padding: clamp(28px, 3vw, 40px) clamp(22px, 2.4vw, 32px) clamp(26px, 2.8vw, 36px);
    border-radius: 22px;
    /* den gamla kaskadens ogenomskinliga kortyta */
    background:
      linear-gradient(180deg, rgba(255, 255, 255, 0.09), transparent 32%),
      linear-gradient(180deg, #1a1d23 0%, #0e1015 100%);
    border: 1px solid rgba(255, 255, 255, 0.14);
    box-shadow:
      inset 0 1px 0 rgba(255, 255, 255, 0.28),
      inset 0 -1px 0 rgba(0, 0, 0, 0.4),
      0 12px 30px rgba(0, 0, 0, 0.42);
  }
  .rstep__n {
    font-size: 13px;
    font-weight: 600;
    letter-spacing: var(--tracking-eyebrow);
    color: var(--fg-3);
  }
  .rstep__h {
    margin-top: var(--space-4);
    font-weight: 600;
    font-size: var(--fs-h3);
    line-height: 1.15;
    letter-spacing: -0.01em;
    color: var(--fg-1);
  }
  .rstep__t {
    margin-top: var(--space-3);
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--fg-3);
    text-wrap: pretty;
  }

  /* ── Skenan: från kort 1:s mitt till kort 3:s mitt, på kortens överkant ──
     Kolumnmitt i ett 3-kolumnsgrid: (100% − 2·gap)/6 från kanten. */
  .rail {
    position: absolute;
    z-index: 2;
    top: var(--rail-y);
    left: calc((100% - 2 * var(--gap)) / 6);
    right: calc((100% - 2 * var(--gap)) / 6);
    height: 0;
    pointer-events: none;
  }
  .rail__line {
    position: absolute;
    left: 0;
    right: 0;
    top: -0.5px;
    height: 1px;
    background: linear-gradient(
      90deg,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 60%) 70% / 0.35),
      hsl(var(--arc-hue) calc(var(--arc-sat) * 60%) 78% / 0.55) 50%,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 60%) 70% / 0.35)
    );
  }
  /* portar: små ringar där skenan möter varje kort */
  .rail__port {
    position: absolute;
    top: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    transform: translate(-50%, -50%);
    background: var(--bg);
    border: 1px solid rgba(255, 255, 255, 0.55);
  }
  .rail__port--1 { left: 0; }
  .rail__port--2 { left: 50%; }
  .rail__port--3 { left: 100%; }

  /* pulsen: .rail__run är lika bred som skenan och förskjuts 0 → 100 % av sin
     egen bredd (transform, inte left) → pulsen vid dess vänsterkant vandrar hela vägen */
  .rail__run {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: 0;
    opacity: 0;
  }
  .rail__pulse {
    position: absolute;
    left: 0;
    top: 0;
    width: 64px;
    height: 2px;
    transform: translate(-100%, -50%);
    border-radius: 2px;
    background: linear-gradient(90deg, transparent, hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 80%) 70%, #fff);
    box-shadow:
      0 0 8px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 70% / 0.8),
      0 0 18px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 60% / 0.45);
  }
  .rail__pulse::after {
    content: "";
    position: absolute;
    right: -3px;
    top: 50%;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    transform: translateY(-50%);
    background: #fff;
    box-shadow: 0 0 10px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 75% / 0.9);
  }

  @media (prefers-reduced-motion: no-preference) {
    .rail__run {
      animation: railRun var(--dur) cubic-bezier(0.45, 0, 0.55, 1) infinite;
    }
    /* porten tänds när pulsen passerar: 0 %, 50 % och 100 % av vägen
       = 0, 0.425 och 0.85 av cykeln (resten av cykeln är uttoning + paus) */
    .rail__port {
      animation: portGlow var(--dur) linear infinite;
    }
    .rail__port--2 { animation-delay: calc(var(--dur) * 0.425); }
    .rail__port--3 { animation-delay: calc(var(--dur) * 0.85); }
  }
  @keyframes railRun {
    0% { transform: translateX(0); opacity: 0; }
    6% { opacity: 1; }
    82% { opacity: 1; }
    85% { transform: translateX(100%); opacity: 0; }
    100% { transform: translateX(100%); opacity: 0; }
  }
  @keyframes portGlow {
    0%, 14%, 100% {
      border-color: rgba(255, 255, 255, 0.55);
      box-shadow: none;
    }
    3% {
      border-color: #fff;
      box-shadow:
        0 0 0 3px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 60% / 0.25),
        0 0 14px hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 65% / 0.8);
    }
  }

  /* ── Avslut ── */
  .rflow__close {
    margin: clamp(40px, 5vw, 64px) auto 0;
    max-width: 640px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-5);
    text-align: center;
  }
  .rflow__close p {
    font-size: var(--fs-body);
    line-height: 1.6;
    color: var(--fg-2);
    text-wrap: pretty;
  }

  /* ── Mobil: lodrät stapel, skenan längs vänsterkanten ── */
  @media (max-width: 820px) {
    .rflow__steps {
      grid-template-columns: 1fr;
      padding-left: 30px;
    }
    /* ändpunkterna vid första/sista kortets mitt (korten är ~lika höga) */
    .rail {
      top: 92px;
      bottom: 92px;
      left: 5px;
      right: auto;
      width: 0;
      height: auto;
    }
    .rail__line {
      top: 0;
      bottom: 0;
      left: -0.5px;
      right: auto;
      width: 1px;
      height: auto;
      background: linear-gradient(
        180deg,
        hsl(var(--arc-hue) calc(var(--arc-sat) * 60%) 70% / 0.35),
        hsl(var(--arc-hue) calc(var(--arc-sat) * 60%) 78% / 0.55) 50%,
        hsl(var(--arc-hue) calc(var(--arc-sat) * 60%) 70% / 0.35)
      );
    }
    .rail__port { left: 0 !important; }
    .rail__port--1 { top: 0; }
    .rail__port--2 { top: 50%; }
    .rail__port--3 { top: 100%; }
    .rail__run {
      width: 0;
      height: 100%;
    }
    .rail__pulse {
      width: 2px;
      height: 48px;
      transform: translate(-50%, -100%);
      background: linear-gradient(180deg, transparent, hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 80%) 70%, #fff);
    }
    .rail__pulse::after {
      right: auto;
      left: 50%;
      top: auto;
      bottom: -3px;
      transform: translateX(-50%);
    }
    @media (prefers-reduced-motion: no-preference) {
      .rail__run { animation-name: railRunY; }
    }
  }
  @keyframes railRunY {
    0% { transform: translateY(0); opacity: 0; }
    6% { opacity: 1; }
    82% { opacity: 1; }
    85% { transform: translateY(100%); opacity: 0; }
    100% { transform: translateY(100%); opacity: 0; }
  }
</style>
