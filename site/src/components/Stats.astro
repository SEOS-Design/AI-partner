---
// Stats.astro – sektion "Läget i siffror" (lätt, skannbar proof-paus).
// v2 (2026-09-29, Björns val "C" + justeringar samma dag):
// - Rubriken står LÅST till vänster (sticky) medan de tre siffrorna rullar förbi till
//   höger, och släpper i linje med sista siffran. Siffrorna är statiska (räknare och
//   tänd/dämpad borttagna, Björn).
// - "Det är där vi kommer in." (samma storlek som rubriken) har en egen rad under
//   kolumnerna, centrerad med lika mycket luft upptill och nedtill.
//   Animation (2026-09-30, Björn): samma som Storys "Vår historia." — varje ord ligger
//   i en mask och glider upp ur den, ett ord i taget, när meningen scrollas in.
//   Ersatte glidningen från vänster (scroll-driven, "alldeles för snabb"; den
//   versionen sparad i Stats.slide.astro.bak — kopiera tillbaka över den här filen).
// Mobil (<860 px): vanligt flöde. Reduced motion / utan JS: allt synligt direkt.
// (v1 = "Editorial stapel", en stat per rad i full bredd — scratchpad-backup.)
//
// KÄLLDISCIPLIN: siffrorna är LÅSTA och verifierade mot primärkällor
// (2026-07-11). Formuleringsvakter som MÅSTE stå kvar: "har potential att"
// (McKinsey — teknisk potential, inte prognos) och "som övervägt" (SCB —
// gruppen siffran avser). Årtal i källraderna. Ändra aldrig utan ny verifiering.

// 2026-10-08 (efter avstämning): Positionering-sektionens budskap + knappar bor nu
// HÄR, direkt under "Det är där vi kommer in." — siffrorna ger skälet, det här ger
// svaret. (Positionering låg under heron och blev för mycket ihop med den rörliga
// heron; dess rubrik står nu i heron. Copy = utkast, Douglas granskar.)
import Arrow from './Arrow.astro';

const STATEMENT = 'Det är där vi kommer in.'.split(' ');
---

<section id="statistik" class="stats" aria-labelledby="stats-heading">
  <div class="container">
    <div class="stats__grid">
      <div class="stats__side">
        <div class="stats__sticky">
          {/* Två bestämda rader (Björn 2026-10-08; fyra rader i den smala kolumnen såg fel ut). */}
          <h2 id="stats-heading" class="h2 stats-h">
            <span class="stats-h__line">Var står svenska</span>{' '}
            <span class="stats-h__line">företag med AI?</span>
          </h2>
        </div>
      </div>

      <ul class="ledger">
        <li class="stat">
          <span class="tick" aria-hidden="true"></span>
          <p class="num">60<span class="soft">–</span>70<span class="soft">&nbsp;%</span></p>
          <div class="meta">
            <p class="claim">av arbetstiden består av uppgifter som dagens AI har potential att ta över.</p>
            <p class="src">
              <a href="https://www.mckinsey.com/capabilities/tech-and-ai/our-insights/the-economic-potential-of-generative-ai-the-next-productivity-frontier" target="_blank" rel="noopener noreferrer">Källa: McKinsey, 2023</a>
            </p>
          </div>
        </li>
        <li class="stat">
          <span class="tick" aria-hidden="true"></span>
          <p class="num">7 <span class="soft">av</span> 10</p>
          <div class="meta">
            <p class="claim">svenska småföretag använder ännu inte AI.</p>
            <p class="src">
              <a href="https://www.scb.se/hitta-statistik/statistik-efter-amne/forskning-och-det-digitala-samhallet/ovrigt/artificiell-intelligens-i-sverige/pong/statistiknyhet/artificiell-intelligens-i-sverige-2026/" target="_blank" rel="noopener noreferrer">Källa: SCB, 2025</a>
            </p>
          </div>
        </li>
        <li class="stat">
          <span class="tick" aria-hidden="true"></span>
          <p class="num">3 <span class="soft">av</span> 4</p>
          <div class="meta">
            <p class="claim">företag som övervägt AI avstår — vanligaste skälet: brist på expertis.</p>
            <p class="src">
              <a href="https://www.scb.se/hitta-statistik/statistik-efter-amne/forskning-och-det-digitala-samhallet/det-digitala-samhallet/it-anvandning-i-foretag/pong/statistiknyhet/it-anvandning-i-foretag-2025/" target="_blank" rel="noopener noreferrer">Källa: SCB, 2025</a>
            </p>
          </div>
        </li>
      </ul>
    </div>
  </div>

  {/* Varje ord i en egen mask och glider upp ur den, ett i taget (som Story). */}
  <div class="statement-track">
    <p class="statement">
      {STATEMENT.map((w, i) => (
        <>
          <span class="statement__mask"><span class="statement__word" style={`--i: ${i}`}>{w}</span></span>
          {i < STATEMENT.length - 1 && ' '}
        </>
      ))}
    </p>
    <div class="statement-more">
      <p class="statement-more__text">
        Vi bygger AI-agenter och automation som tar det repetitiva, så att teamen lägger
        tiden där den gör skillnad och ni växer utan att anställa fler. Utgångspunkten är
        era egna processer och data. Vi automatiserar bara det som lönar sig.
      </p>
      <div class="statement-more__cta">
        <a class="btn btn-primary" href="/kontakt">Boka kartläggning <Arrow class="arrow" /></a>
        <a class="btn btn-glass" href="/om-oss">Mer om oss <Arrow class="arrow" /></a>
      </div>
    </div>
  </div>
</section>

<style>
  /* Raised band — lyfter sektionen från void-sektionerna runtom. */
  .stats {
    padding: var(--section-py) 0;
    background: var(--bg-raised);
    border-block: 1px solid var(--border);
  }
  .container {
    max-width: var(--maxw-content);
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  /* ---- Två kolumner: låst rubrik vänster, siffrorna rullar höger ---- */
  .stats__grid {
    --g: clamp(40px, 5vw, 64px); /* smal skärm; bred skärm sätts nedan */
    display: grid;
    /* Lika breda kolumner med rejäl luft emellan. (En bredare vänsterkolumn provades
       2026-10-08 för rubrikens skull — Björn: rubriken kom för nära siffrorna och
       siffrorna flyttades. Rubriken anpassar i stället sin storlek till kolumnen.) */
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(40px, 6vw, 96px);
    align-items: start;
  }
  .stats__side {
    align-self: stretch; /* lika hög som listan → rubriken släpper i linje med sista siffran */
    container-type: inline-size; /* rubrikens storlek räknas från kolumnens bredd */
  }
  /* Smal skärm: en kolumn, rubriken ovanför siffrorna och inte låst (i två kolumner
     blev rubriken ~20 px i en 160 px bred spalt). */
  @media (max-width: 859px) {
    .stats__grid { grid-template-columns: minmax(0, 1fr); }
    .stats__sticky { position: static !important; }
  }
  @media (min-width: 860px) {
    .stats__grid { --g: clamp(96px, 20svh, 220px); }
  }
  .stats__sticky {
    position: sticky;
    top: clamp(110px, 16vh, 150px); /* under nav-pillen */
  }
  /* Storleken = det minsta av sajtens h2 och vad som får plats: den längre raden
     ("Var står svenska") är ~5,6 em bred (uppmätt) → 100cqi / 5.7 fyller kolumnen.
     Med 478 px kolumn (1440 och uppåt) blir det ~84 px, något under h2:ans 96. */
  .stats-h {
    margin: 0;
    font-size: min(var(--fs-h2), calc(100cqi / 5.7));
  }
  .stats-h__line {
    display: block;
    white-space: nowrap;
  }

  /* ---- Siffrorna ---- */
  .ledger {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .stat {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
    /* --g = luften mellan en stats text och linjen, LIKA stor över och under varje
       linje (Björn 2026-10-08). Förut: 58svh höga utrymmen med centrerat innehåll —
       när första staten lades i överkant hamnade all tom yta under den. --g är
       tilltagen (≈ 20 % av vyn) så att den låsta rubriken får en sträcka att stå
       kvar under, ungefär lika lång som förut. */
    padding: var(--g) 0;
  }
  /* Linjer bara MELLAN siffrorna — ingen ovanför den första eller under den sista
     (Björn 2026-10-08). Skarpare än förut (--border-strong, var --border). */
  .stat + .stat {
    border-top: 1px solid var(--border-strong);
  }
  .stat:first-child .tick {
    display: none;
  }
  /* Linjering mot rubriken (Björn 2026-10-08): första siffran börjar i höjd med
     rubrikens överkant, och sista statens sista rad slutar i höjd med rubrikens
     underkant när den släpper. (Förut var alla centrerade i sitt utrymme → den första
     låg för lågt och den sista slutade för högt.)
     text-box-trim beskär textrutorna till versalhöjd resp. baslinje, så att det är
     BOKSTÄVERNAS kanter som linjerar, oavsett teckenstorlek (Chrome/Edge/Safari;
     andra webbläsare hamnar några pixlar ifrån). */
  .stat:first-child {
    padding-top: 0;
  }
  .stat:last-child {
    padding-bottom: 0;
  }
  .stats-h {
    text-box: trim-both cap alphabetic;
  }
  /* Beskärningen på ALLA siffror och källrader (inte bara första/sista), så att --g
     är det avstånd ögat ser: från bokstävernas kant till linjen, lika på båda sidor. */
  .num {
    text-box: trim-start cap alphabetic;
  }
  .src {
    text-box: trim-end cap alphabetic;
  }
  /* Accentlinjen på radens hårstreck (ingen blur — gradientstoppen gör uttoningen). */
  .tick {
    position: absolute;
    top: -1px;
    left: 0;
    width: min(100%, clamp(200px, 60%, 420px)); /* aldrig bredare än kolumnen */
    height: 1px;
    background: linear-gradient(
      90deg,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 84% / 0) 0%,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 84% / 1) 6%,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 80% / 0.7) 48%,
      hsl(var(--arc-hue) calc(var(--arc-sat) * 100%) 78% / 0) 100%
    );
  }

  /* 3) Siffror som inte står mitt i vyn tonas ner (Björn 2026-10-08). Ren CSS, i takt
     med scrollen (view-timeline per element): full styrka runt vyns mitt, dämpad när
     siffran är på väg in eller ut. Webbläsare utan stöd visar allt i full styrka.
     (En tänd/dämpad-effekt togs bort i v2 — den här är mjukare och rör bara innehållet,
     inte linjerna.) */
  @media (min-width: 860px) and (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      .stat .num,
      .stat .meta {
        animation: statFocus linear both;
        animation-timeline: view();
        animation-range: cover 0% cover 100%;
      }
    }
  }
  @keyframes statFocus {
    0% { opacity: 0.22; }
    36% { opacity: 1; }
    64% { opacity: 1; }
    100% { opacity: 0.22; }
  }
  /* <p> som fungerar som rubrik/siffra → smal bredd. */
  .num {
    font-stretch: 75%;
    margin: 0;
    font-weight: 700;
    font-size: clamp(60px, 7.6vw, 120px);
    line-height: 0.98;
    letter-spacing: -0.03em;
    color: var(--fg-1);
    font-variant-numeric: tabular-nums;
  }
  .num .soft {
    color: var(--fg-3);
    font-weight: 500;
  }
  .claim {
    font-stretch: 75%;
    max-width: 28ch;
    margin: 0;
    font-size: var(--fs-lead);
    font-weight: 500;
    line-height: 1.5;
    color: var(--fg-1);
    text-wrap: pretty;
  }
  .src {
    font-stretch: 75%;
    margin: 14px 0 0;
    font-size: var(--fs-small);
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .src a {
    color: var(--fg-3);
    /* Vanlig textunderstrykning (var border + padding): rutan slutar då på baslinjen,
       vilket linjeringen och avståndet till linjen räknar med. */
    text-decoration: underline;
    text-decoration-color: var(--border-strong);
    text-underline-offset: 3px;
    transition: color var(--dur-fast) var(--ease), text-decoration-color var(--dur-fast) var(--ease);
  }
  .src a:hover {
    color: var(--fg-2);
    text-decoration-color: var(--fg-3);
  }
  .src a:focus-visible {
    outline: none;
    box-shadow: var(--focus-ring);
    border-radius: 2px;
  }

  /* ---- Slutmeningen ---- */
  .statement {
    font-stretch: 75%;
    margin: 0;
    font-weight: 700;
    font-size: var(--fs-h2); /* samma storlek som rubriken (Björn) */
    line-height: var(--lh-heading);
    letter-spacing: var(--tracking-display);
    color: var(--fg-1);
    text-align: center;
    text-wrap: balance;
  }
  /* Masken klipper ordet; lite luft nedtill så att å/ä/g inte klipps (som Story). */
  .statement__mask {
    display: inline-block;
    overflow: clip;
    vertical-align: top;
    padding-bottom: 0.08em;
    margin-bottom: -0.08em;
  }
  .statement__word {
    display: inline-block;
  }
  /* Budskapet + knapparna under meningen (flyttat från Positionering 2026-10-08). */
  .statement-more {
    max-width: 44em;
    margin: clamp(24px, 3vw, 40px) auto 0;
    text-align: center;
  }
  .statement-more__text {
    margin: 0;
    font-size: var(--fs-lead);
    line-height: var(--lh-body);
    color: var(--fg-2);
    text-wrap: pretty;
  }
  .statement-more__cta {
    margin-top: var(--space-6);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--space-4);
  }
  /* Standard (mobil): vanlig rad med luft omkring. */
  .statement-track {
    padding: clamp(56px, 8vw, 112px) var(--space-5) 0;
  }

  /* Bred skärm: samma slutläge som när meningen gled in — --gap + --run luft ovanför
     och lika mycket nedtill (sektionens padding) → centrerad i sin rad. */
  @media (min-width: 860px) {
    .stats {
      --gap: var(--space-7);
      --run: 16svh;
      padding-bottom: calc(var(--gap) + var(--run));
    }
    .statement-track {
      padding: calc(var(--gap) + var(--run)) var(--space-5) 0;
    }
    .statement {
      white-space: nowrap;
    }
  }

  /* ---- animation (bara när scriptet satt .will-reveal) — samma värden som Story ---- */
  .statement-track.will-reveal .statement__word {
    transform: translateY(125%);
    transition: transform 0.9s var(--ease);
    transition-delay: calc(0.1s + var(--i) * 0.11s);
  }
  /* Texten och knapparna tonas in en gång efter orden (ingen scrollanimation på
     brödtext — Björns regel). */
  .statement-track.will-reveal .statement-more {
    opacity: 0;
    transform: translateY(12px);
    transition: opacity 0.8s var(--ease), transform 0.8s var(--ease);
    transition-delay: 0.9s;
  }
  .statement-track.will-reveal.is-in .statement__word,
  .statement-track.will-reveal.is-in .statement-more {
    transform: none;
    opacity: 1;
  }
</style>

<script>
  // Orden glider upp ur sina masker när meningen scrollas in (samma som Story).
  // Utan JS och vid reduced motion syns meningen direkt; .will-reveal (dolt läge)
  // sätts först när scriptet vet att det kan animera.
  const track = document.querySelector<HTMLElement>('.statement-track');
  const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (track && !reduced && 'IntersectionObserver' in window) {
    const statement = track.querySelector('.statement');
    // Redan i vyn vid laddning → visa direkt, ingen animation.
    const r = statement?.getBoundingClientRect();
    if (statement && r && r.top > window.innerHeight * 0.85) {
      track.classList.add('will-reveal');
      const io = new IntersectionObserver(
        (entries) => {
          if (!entries.some((e) => e.isIntersecting)) return;
          track.classList.add('is-in');
          io.disconnect();
        },
        // Startar när meningen nått ungefär 20 % upp i bild.
        { rootMargin: '0px 0px -20% 0px' },
      );
      io.observe(statement);
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    }
  }
</script>
