  {id === 'kvalitet-projekt' && (
    <>
      <g transform="translate(43,18) matrix(.866,.5,0,1,0,0)"><rect width="152" height="100" rx="6" class="d" /></g>
      <g transform="translate(36,22) matrix(.866,.5,0,1,0,0)">
        <rect width="152" height="100" rx="6" class="l" /><path d="M0 16H152" class="d" /><circle cx="10" cy="8" r="2" class="wd" /><path d="M20 8H56" class="d" />
        <path d="M10 42H142" class="a n lim" stroke-dasharray="3 4" /><path d="M10 88H142M10 66H142" class="d dd" />
